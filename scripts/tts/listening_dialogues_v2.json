  "tracks": [
    {
      "id": "a",
      "assetId": "audio-l0-m01-c01-l06-a",
      "title": "At the tea counter",
      "filename": "fja-l06-real-dialogue-a-v2.wav",
      "objectiveId": "l0-m01-c01-l06-o1",
      "turns": [
        {
          "speaker": "male",
          "text": "こんにちは。お茶をお願いします。",
          "english": "Hello. Tea, please."
        },
        {
          "speaker": "female",
          "text": "こんにちは。温かいお茶ですか。冷たいお茶ですか。",
          "english": "Hello. Hot tea or cold tea?"
        },
        {
          "speaker": "male",
          "text": "温かいお茶をお願いします。",
          "english": "Hot tea, please."
        },
        {
          "speaker": "female",
          "text": "はい、どうぞ。",
          "english": "Certainly. Here you are."
        },
        {
          "speaker": "male",
          "text": "ありがとうございます。",
          "english": "Thank you."
        }
      ]
    },
    {
      "id": "b",
      "assetId": "audio-l0-m01-c01-l06-b",
      "title": "A walk by the mountain",
      "filename": "fja-l06-real-dialogue-b-v2.wav",
      "objectiveId": "l0-m01-c01-l06-o2",
      "turns": [
        {
          "speaker": "female",
          "text": "おはようございます。今日はいい天気ですね。",
          "english": "Good morning. Nice weather today, isn't it?"
        },
        {
          "speaker": "male",
          "text": "おはようございます。そうですね。あの山がきれいですね。",
          "english": "Good morning. Yes, it is. That mountain is beautiful."
        },
        {
          "speaker": "female",
          "text": "山の近くに桜がありますよ。",
          "english": "There are cherry blossoms near the mountain."
        },
        {
          "speaker": "male",
          "text": "そうですか。じゃあ、一緒に行きましょう。",
          "english": "Oh, really? Then let's go together."
        },
        {
          "speaker": "female",
          "text": "はい、行きましょう。",
          "english": "Yes, let's go."
        }
      ]
    }
  ]
