        "reading",
        "vocabulary"
      ],
      "choices": [
        {
          "id": "c1",
          "text": "あります",
          "rationale": "あります is ordinarily for objects, not a cat."
        },
        {
          "id": "c2",
          "text": "います",
          "rationale": "います is the ordinary existence verb for an animal."
        },
        {
          "id": "c3",
          "text": "ですか",
          "rationale": "ですか is not an existence verb."
        }
      ],
      "answerKey": {
        "choiceId": "c2"
      },
      "explanation": "います is the ordinary existence verb for an animal."
