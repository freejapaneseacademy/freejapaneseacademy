        "l0-m01-c02-l02-o4"
      ],
      "knowledgeItemIds": [
        "word-ie-iie"
      ],
      "prompt": "Ren points to a house. Which response correctly names the object, rather than saying no?",
      "example": "いえ　いいえ",
      "choices": [
        {
          "id": "ie",
          "text": "いえ",
          "rationale": "Correct. いえ is house in this context."
        },
        {
          "id": "iie",
          "text": "いいえ",
          "rationale": "いいえ means no, a response, not the object house."
        },
        {
          "id": "isu",
          "text": "いす",
          "rationale": "いす means chair, not house."
        }
      ],
      "answerKey": {
        "choiceId": "ie"
      },
      "explanation": "いえ is house (い・え, two morae); いいえ is no (い・い・え, three morae).",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "vocabulary",
        "written-mora-awareness"
      ]
    },
    {
      "id": "ex-l0-m01-c02-l02-008",
