{
  "lessonId": "l0-m01-c02-l02",
  "version": 1,
  "items": [
    {
      "id": "ex-l0-m01-c02-l02-001",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c02-l02-o1"
      ],
      "knowledgeItemIds": [
        "vowel-a"
      ],
      "prompt": "Which kana is the Japanese vowel labeled a?",
      "example": "あ　い　う　え　お",
      "choices": [
        {
          "id": "a",
          "text": "あ",
          "rationale": "Correct: あ is /a/. The letter a is a label, not English 'ay'."
        },
        {
          "id": "e",
          "text": "え",
          "rationale": "え is /e/, a different vowel."
        },
        {
          "id": "o",
          "text": "お",
          "rationale": "お is /o/, not /a/."
        }
      ],
      "answerKey": {
        "choiceId": "a"
      },
      "explanation": "あ represents the steady Japanese vowel /a/. English letter names are not reliable pronunciation models.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "vocabulary",
        "written-mora-awareness"
      ]
    },
    {
      "id": "ex-l0-m01-c02-l02-002",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c02-l02-o1"
      ],
      "knowledgeItemIds": [
        "syllable-ka"
      ],
      "prompt": "Which single kana represents the sound unit ka?",
      "example": "か　き　く",
      "choices": [
        {
          "id": "ka",
          "text": "か",
          "rationale": "Correct. か is k + a, one mora."
        },
        {
          "id": "ki",
          "text": "き",
          "rationale": "き is ki, with vowel /i/."
        },
        {
          "id": "ku",
          "text": "く",
          "rationale": "く is ku, with vowel /u/."
        }
      ],
      "answerKey": {
        "choiceId": "ka"
      },
      "explanation": "か represents ka as one mora; かさ is a two-mora word.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "vocabulary",
        "written-mora-awareness"
      ]
    },
    {
      "id": "ex-l0-m01-c02-l02-003",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c02-l02-o1"
      ],
      "knowledgeItemIds": [
        "syllable-shi"
      ],
      "prompt": "Which kana is conventionally written shi in beginner romaji?",
      "example": "さ　し　す",
      "choices": [
        {
          "id": "shi",
          "text": "し",
          "rationale": "Correct. し is written shi in the romanization used here."
        },
        {
          "id": "sa",
          "text": "さ",
          "rationale": "さ is sa, not shi."
        },
        {
          "id": "su",
          "text": "す",
          "rationale": "す is su, not shi."
        }
      ],
      "answerKey": {
        "choiceId": "shi"
      },
      "explanation": "し is the second mora in すし. Romaji is a spelling aid, not a full phonetic description.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "vocabulary",
        "written-mora-awareness"
      ]
    },
    {
      "id": "ex-l0-m01-c02-l02-004",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c02-l02-o1"
      ],
      "knowledgeItemIds": [
        "syllable-ku"
      ],
      "prompt": "Which k-row kana contains the vowel う (/u/)?",
      "example": "か　き　く　け　こ",
      "choices": [
        {
          "id": "ku",
          "text": "く",
          "rationale": "Correct. く corresponds to ku."
        },
        {
          "id": "ko",
          "text": "こ",
          "rationale": "こ is ko, with /o/."
        },
        {
          "id": "ke",
          "text": "け",
          "rationale": "け is ke, with /e/."
        }
      ],
      "answerKey": {
        "choiceId": "ku"
      },
      "explanation": "The k-row follows a, i, u, e, o: か・き・く・け・こ.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "vocabulary",
        "written-mora-awareness"
      ]
    },
    {
      "id": "ex-l0-m01-c02-l02-005",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c02-l02-o2"
      ],
      "knowledgeItemIds": [
        "word-kao"
      ],
      "prompt": "Emi points to a face. Which written word labels the picture?",
      "example": "かお　かさ　いす",
      "choices": [
        {
          "id": "kao",
          "text": "かお",
          "rationale": "Correct. かお means face."
        },
        {
          "id": "kasa",
          "text": "かさ",
          "rationale": "かさ means umbrella, not face."
        },
        {
          "id": "isu",
          "text": "いす",
          "rationale": "いす means chair, not face."
        }
      ],
      "answerKey": {
        "choiceId": "kao"
      },
      "explanation": "かお (kao) means face and has two morae: か・お.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "vocabulary",
        "written-mora-awareness"
      ]
    },
    {
      "id": "ex-l0-m01-c02-l02-006",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c02-l02-o2"
      ],
      "knowledgeItemIds": [
        "word-kasa"
      ],
      "prompt": "Which word means umbrella in the picture-card scene?",
      "example": "かさ　かお　すし",
      "choices": [
        {
          "id": "kasa",
          "text": "かさ",
          "rationale": "Correct. かさ means umbrella."
        },
        {
          "id": "kao",
          "text": "かお",
          "rationale": "かお means face, not umbrella."
        },
        {
          "id": "sushi",
          "text": "すし",
          "rationale": "すし means sushi, not umbrella."
        }
      ],
      "answerKey": {
        "choiceId": "kasa"
      },
      "explanation": "かさ (kasa) is an umbrella. It is two morae: か・さ.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "vocabulary",
        "written-mora-awareness"
      ]
    },
    {
      "id": "ex-l0-m01-c02-l02-007",
      "version": 1,
