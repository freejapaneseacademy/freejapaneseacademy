      "prompt": "How many written morae are in あおい?",
      "example": "あおい",
      "choices": [
        {
          "id": "three",
          "text": "Three: あ・お・い",
          "rationale": "Correct. Each of these vowel kana contributes a mora."
        },
        {
          "id": "two",
          "text": "Two: あお・い",
          "rationale": "あ and お are separate vowel morae in this word."
        },
        {
          "id": "one",
          "text": "One",
          "rationale": "The word is not a single mora."
        }
      ],
      "answerKey": {
        "choiceId": "three"
      },
      "explanation": "あおい has three morae; compare the color noun あお, with two.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
