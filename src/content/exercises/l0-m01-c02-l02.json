        {
          "id": "ao",
          "text": "あお",
          "rationale": "あお names the color blue; it is not a food."
        },
        {
          "id": "isu",
          "text": "いす",
          "rationale": "いす means chair, not food."
        }
      ],
      "answerKey": {
        "choiceId": "sushi"
      },
      "explanation": "すし is the word sushi, two written morae す・し. Its u may be weakened in natural speech.",
