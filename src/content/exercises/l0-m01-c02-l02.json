      "knowledgeItemIds": [
        "word-aoi"
      ],
      "prompt": "Which phrase naturally describes a blue umbrella?",
      "example": "あお　あおい　かさ",
      "choices": [
        {
          "id": "aoi",
          "text": "あおい かさ",
          "rationale": "Correct. あおい is the adjective directly describing かさ."
        },
        {
          "id": "ao",
          "text": "あお かさ",
          "rationale": "あお is the color noun; use あおい to modify かさ in this pattern."
        },
        {
          "id": "kasa",
          "text": "かさ あおい",
          "rationale": "This is not the normal noun-modifying order for the simple phrase taught here."
        }
      ],
      "answerKey": {
        "choiceId": "aoi"
      },
      "explanation": "あおい かさ means a blue umbrella; あおい is a three-mora adjective.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "vocabulary",
        "written-mora-awareness"
      ]
    },
    {
