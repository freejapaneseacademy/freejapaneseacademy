      "prompt": "Which sentence means 'I am a student' politely?",
      "choices": [
        {
          "id": "a",
          "text": "わたしは学生です。",
          "rationale": "は marks the topic; 学生です states the identity."
        },
        {
          "id": "b",
          "text": "わたしの学生です。",
          "rationale": "の would link nouns, not mark the topic."
        },
        {
          "id": "c",
          "text": "わたしは学生か。",
          "rationale": "か alone is not the polite ですか question pattern."
        }
      ],
      "correctIndex": 0,
      "answerKey": {
        "choiceId": "a"
      },
      "explanation": "は marks the topic; 学生です states the identity.",
      "evidence": "わたしは学生です。"
    },
