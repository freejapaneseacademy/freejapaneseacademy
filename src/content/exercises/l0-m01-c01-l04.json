        "l0-m01-c01-l04-o3"
      ],
      "knowledgeItemIds": [
        "word-sakura"
      ],
      "prompt": "A beginner sees さくら in a picture caption. Which description fits its written form?",
      "example": "さくら",
      "choices": [
        {
          "id": "a",
          "text": "Three hiragana characters",
          "rationale": "Correct: さ・く・ら are hiragana."
        },
        {
          "id": "b",
          "text": "Three katakana characters",
          "rationale": "Katakana would use サクラ."
        },
        {
          "id": "c",
          "text": "Three kanji characters",
          "rationale": "There are no kanji in さくら."
        }
      ],
      "answerKey": {
        "choiceId": "a"
      },
      "explanation": "さくら (sakura, cherry blossom) uses hiragana さ・く・ら. The same word can be written differently in some contexts.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "kana-recognition",
        "script-identification"
      ]
    },
    {
      "id": "ex-l0-m01-c01-l04-006",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c01-l04-o3"
      ],
      "knowledgeItemIds": [
        "word-koohii"
      ],
      "prompt": "What does the mark ー do in コーヒー?",
      "example": "コーヒー",
      "choices": [
        {
          "id": "a",
          "text": "It extends the preceding vowel sound",
          "rationale": "Correct: ー marks vowel length in katakana."
        },
        {
          "id": "b",
          "text": "It separates two English words",
          "rationale": "Japanese long-vowel marks are not English spaces."
        },
        {
          "id": "c",
          "text": "It turns the word into kanji",
          "rationale": "The word remains in katakana."
        }
      ],
      "answerKey": {
        "choiceId": "a"
      },
      "explanation": "The long-vowel mark ー lengthens the preceding vowel. コーヒー is written in katakana and means coffee.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "kana-recognition",
        "script-identification"
      ]
    },
    {
      "id": "ex-l0-m01-c01-l04-007",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c01-l04-o4"
      ],
      "knowledgeItemIds": [
        "kanji-yama"
      ],
      "prompt": "In the sample 山（やま）, which statement is accurate?",
      "example": "山（やま）",
      "choices": [
        {
          "id": "a",
          "text": "山 is a kanji and やま is its reading here",
          "rationale": "Correct: やま supplies the reading of 山 in this example."
        },
        {
          "id": "b",
          "text": "山 is a katakana vowel",
          "rationale": "山 is kanji, not katakana."
        },
        {
          "id": "c",
          "text": "やま is the English translation",
          "rationale": "やま is Japanese reading; mountain is English meaning."
        }
      ],
      "answerKey": {
        "choiceId": "a"
      },
      "explanation": "山 is a kanji; やま is the reading in this example. Recognize the role, but do not memorize kanji readings yet.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "kana-recognition",
        "script-identification"
      ]
    },
    {
      "id": "ex-l0-m01-c01-l04-008",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c01-l04-o4"
      ],
      "knowledgeItemIds": [
        "furigana-role"
      ],
      "prompt": "What is the role of small やま shown above 山 in a textbook?",
      "example": "山（やま）",
      "choices": [
        {
          "id": "a",
          "text": "It is a second unrelated word",
          "rationale": "The small kana annotate the kanji reading."
        },
        {
          "id": "b",
          "text": "It is furigana showing how to read the kanji",
          "rationale": "Correct: furigana are small reading guides."
        },
        {
          "id": "c",
          "text": "It is romaji",
          "rationale": "Romaji uses Latin letters, not kana."
        }
      ],
      "answerKey": {
        "choiceId": "b"
      },
      "explanation": "Furigana are reading annotations, usually in kana; they are not a separate fifth writing system.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "kana-recognition",
        "script-identification"
      ]
    },
