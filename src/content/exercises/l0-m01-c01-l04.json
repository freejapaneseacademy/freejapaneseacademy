      ],
      "knowledgeItemIds": [
        "kana-hira-a"
      ],
      "prompt": "Which script is the large character あ written in?",
      "example": "あ",
      "choices": [
        {
          "id": "a",
          "text": "Hiragana",
          "rationale": "Correct: あ is the hiragana vowel a."
        },
        {
          "id": "b",
          "text": "Katakana",
          "rationale": "ア, not あ, is the katakana form."
        },
        {
          "id": "c",
          "text": "Kanji",
          "rationale": "あ is a kana, not a kanji."
        }
      ],
      "answerKey": {
        "choiceId": "a"
      },
      "explanation": "あ is hiragana. Its katakana partner is ア; both represent the vowel /a/.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "kana-recognition",
        "script-identification"
      ]
    },
    {
      "id": "ex-l0-m01-c01-l04-002",
      "version": 1,
      "objectiveIds": [
