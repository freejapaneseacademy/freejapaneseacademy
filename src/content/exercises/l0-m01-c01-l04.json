      ],
      "prompt": "Which script is the large character ア written in?",
      "example": "ア",
      "choices": [
        {
          "id": "a",
          "text": "Hiragana",
          "rationale": "あ is the hiragana form."
        },
        {
          "id": "b",
          "text": "Katakana",
          "rationale": "Correct: ア is the katakana vowel a."
        },
        {
          "id": "c",
          "text": "Romaji",
          "rationale": "Romaji would use the Latin letter a."
        }
      ],
      "answerKey": {
        "choiceId": "b"
      },
      "explanation": "ア is katakana; あ is hiragana. Script shape changes, not the vowel.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "kana-recognition",
        "script-identification"
      ]
    },
    {
      "id": "ex-l0-m01-c01-l04-003",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c01-l04-o1"
      ],
      "knowledgeItemIds": [
        "kana-pair-i"
      ],
      "prompt": "Which katakana character represents the same vowel as hiragana い?",
      "example": "い",
      "choices": [
        {
          "id": "a",
          "text": "エ",
          "rationale": "エ is e, not i."
        },
        {
          "id": "b",
          "text": "イ",
          "rationale": "Correct: イ corresponds to い."
        },
        {
          "id": "c",
          "text": "ウ",
          "rationale": "ウ is u, not i."
        }
      ],
      "answerKey": {
        "choiceId": "b"
      },
      "explanation": "い and イ both represent the vowel i. Do not confuse イ with エ.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "kana-recognition",
        "script-identification"
      ]
    },
    {
      "id": "ex-l0-m01-c01-l04-004",
      "version": 1,
      "objectiveIds": [
        "l0-m01-c01-l04-o1"
      ],
      "knowledgeItemIds": [
        "kana-pair-u"
      ],
      "prompt": "Which hiragana character matches katakana ウ?",
      "example": "ウ",
      "choices": [
        {
          "id": "a",
          "text": "う",
          "rationale": "Correct: う corresponds to ウ."
        },
        {
          "id": "b",
          "text": "え",
          "rationale": "え is e."
        },
        {
          "id": "c",
          "text": "お",
          "rationale": "お is o."
        }
      ],
      "answerKey": {
        "choiceId": "a"
      },
      "explanation": "ウ and う represent the vowel u; they are different scripts.",
      "type": "single-choice",
      "status": "published",
      "level": "l0",
      "skills": [
        "kana-recognition",
        "script-identification"
      ]
    },
    {
