---
import Base from '../../layouts/Base.astro';
const questions = [
  {q:'Is FreeJapaneseAcademy really free?',a:'Yes. The goal is to provide accessible Japanese learning without charging students for lessons or practice.'},
  {q:'Can I start without knowing any Japanese?',a:'Absolutely. The future N5 curriculum will start with the fundamentals, including writing systems and simple expressions. For now, try the short hiragana demonstration lesson.'},
  {q:'Are all N5–N1 courses available already?',a:'Not yet. This is the first-stage website preview. The learning pathways are mapped out, and detailed lessons and examinations will be added in later phases.'},
  {q:'Do I need an account to save my progress?',a:'No. Your browser saves demonstration lesson completions, bookmarks, and quiz attempts locally using IndexedDB.'},
  {q:'Will my progress sync across devices?',a:'No. Progress currently belongs to the browser profile where it was created. Use the dashboard export/import tools to move your data or keep a backup.'},
  {q:'Are the practice questions official JLPT questions?',a:'No. Our demonstration questions are original practice examples and should not be treated as official JLPT examinations.'},
];
---
<Base title="Frequently Asked Questions" description="Answers about FreeJapaneseAcademy, free courses, JLPT learning levels, progress saving and the Phase 1 website preview." breadcrumbs={[{label:'FAQ',href:'/faq/'}]}>
  <section class="page-hero"><div class="container"><span class="eyebrow">HERE TO HELP</span><h1>Questions? We've<br/>got a few answers.</h1><p>Everything you need to know about how this free Japanese-learning platform is being built.</p></div></section>
  <section class="prose-page"><div class="faq-list">{questions.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div><p style="margin-top:35px">Ready to try it? <a class="text-link" href="/learn/n5/hiragana-introduction/">Open the demonstration lesson ↗</a></p></section>
</Base>
