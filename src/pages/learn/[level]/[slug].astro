---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LessonActions from '../../../components/interactive/LessonActions';
import { levelById } from '../../../lib/curriculum';
export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map(lesson => ({ params: { level: lesson.data.level, slug: lesson.id.split('/').pop() }, props: { lesson } }));
}
const { lesson } = Astro.props;
const { Content } = await render(lesson);
const level = levelById(lesson.data.level)!;
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={lesson.data.isDemo} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:level.label,href:`/learn/${level.id}/`},{label:lesson.data.title,href:`/learn/${level.id}/${lesson.id.split('/').pop()}/`}]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href={`/learn/${level.id}/`}>{level.label}</a><span>›</span><span>Sample lesson</span></nav><span class="eyebrow">{level.label} · {lesson.data.chapter} · {lesson.data.minutes} MIN</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p></div></section>
  <div class="page-body"><div class="container lesson-layout"><div class="lesson-content">
    <div class="course-notice" style="margin:0 0 27px"><strong>Demonstration lesson:</strong> This is a short sample of the course experience, not a complete chapter.</div>
    <section class="lesson-intro"><h2>By the end, you'll be able to…</h2><ul>{lesson.data.objectives.map(objective => <li>{objective}</li>)}</ul></section>
    <article class="lesson-article"><Content /></article>
    <LessonActions client:load lessonId={lesson.id} level={lesson.data.level} />
    <div class="lesson-next"><h3>Put your knowledge into practice</h3><p>Ready to test what you've learned? Try a short three-question quiz.</p><a class="btn btn-primary" href="/practice/demo/">Take the demonstration quiz ↗</a></div>
  </div><aside class="lesson-side"><span class="eyebrow">LESSON GUIDE</span><h3>{lesson.data.chapter}</h3><p>Part of the {level.label} pathway · {lesson.data.minutes} min read</p><div class="sample-rule"></div><p>Read at your own pace. Mark the lesson complete when you feel ready and bookmark it for later.</p><a class="text-link" href={`/learn/${level.id}/`} style="margin-top:22px">← Back to {level.label}</a></aside></div></div>
</Base>
