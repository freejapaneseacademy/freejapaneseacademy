---
import Base from '../../layouts/Base.astro';
import { levels } from '../../lib/curriculum';
import inventory from '../../../docs/LESSON_INVENTORY.json';
import '../../styles/course-pathway.css';

// Level 0 is a real first-class pathway card. Keep JLPT-specific levels
// unchanged for other pages, but render all six cards together here.
const pathways = [
  {
    id: 'start',
    href: '/learn/start/',
    label: 'L0',
    name: 'Japanese Foundations',
    rank: '00',
    stage: 'Pre-JLPT · Start here',
    tone: 'foundations'
  },
  ...levels.map(level => ({ ...level, href: `/learn/${level.id}/` }))
];
const publishedFoundations = inventory.items.filter(
  item => item.level === 'l0' && item.status === 'published'
).length;
---
<Base title="Japanese Learning Pathway — Foundations to N1" description="Begin Japanese at Level 0 Foundations, then follow the JLPT N5–N1 learning pathway at FreeJapaneseAcademy." breadcrumbs={[{label:'Courses',href:'/learn/'}]}>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">›</span><span aria-current="page">Courses</span>
      </nav>
      <span class="eyebrow">EXPLORE YOUR PATH</span>
      <h1>Every level starts<br/>with curiosity.</h1>
      <p>Begin with Japanese Foundations at Level 0, then move through five progressive JLPT pathways from N5 to N1.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">FROM FOUNDATIONS TO JLPT N1</span>
          <h2>Find your starting point.</h2>
        </div>
        <p class="lead">New to Japanese? Start with Level 0, then progress to N5. Already studying? Choose the stage that matches your experience.</p>
      </div>
      <div class="course-grid course-grid--pathway" aria-label="Japanese learning levels">
        {pathways.map(pathway => (
          <a href={pathway.href} class:list={[`course-card tone-${pathway.tone}`, { 'course-card--foundations': pathway.id === 'start' }]}>
            <span class="course-num">{pathway.rank}</span>
            <div class="course-symbol" aria-hidden="true">{pathway.label}</div>
            <strong>{pathway.name}</strong>
            <small>{pathway.stage}</small>
            <div class="course-bottom"><span>View pathway</span><span aria-hidden="true">↗</span></div>
          </a>
        ))}
      </div>
      <div class="course-notice">
        <strong>Learning is growing:</strong> Level 0 Foundations currently has {publishedFoundations} published lessons and checkpoints. JLPT pathways and full-length practice exams are being developed, with an N5 demonstration lesson available.
      </div>
    </div>
  </section>
</Base>
