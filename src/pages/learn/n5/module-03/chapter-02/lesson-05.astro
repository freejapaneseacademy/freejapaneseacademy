---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RoutineNoteReading from '../../../../../components/interactive/RoutineNoteReading';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/daily-routine-note-reading');
if(!lesson||lesson.data.lessonId!=='n5-m03-c02-l05')throw new Error('Missing canonical lesson n5-m03-c02-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Daily routine verbs',href:'/learn/n5/module-03/chapter-02/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 03 · Chapter 02 · Lesson 05</span></nav><span class="eyebrow">N5 · MODULE 03 · CHAPTER 02 · LESSON 05</span><h1>Read a daily routine note</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Original written note</span><span>10 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original fictional reading.</strong> Independent Japanese and assessment reviews pending. No audio or pronunciation assessment is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><RoutineNoteReading client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and reading score are recorded separately.</p><LessonActions client:load lessonId="n5-m03-c02-l05" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: an original routine conversation in Lesson 06 after audio verification.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">READING STRATEGY</span><h3>Check the ending</h3><p>Find the time and action, then check ます versus ません. Cite A–G rather than guessing.</p></aside></div></section>
</Base>