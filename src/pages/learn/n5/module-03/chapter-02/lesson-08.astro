---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RoutineRoleplay from '../../../../../components/interactive/RoutineRoleplay';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/daily-routine-roleplay');
if(!lesson||lesson.data.lessonId!=='n5-m03-c02-l08')throw new Error('Missing canonical lesson n5-m03-c02-l08');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Daily routine verbs',href:'/learn/n5/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 03 · Chapter 02 · Lesson 08</span></nav><span class="eyebrow">N5 · MODULE 03 · CHAPTER 02 · LESSON 08</span><h1>Talk through a school day</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Optional roleplay</span><span>8 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written speaking models.</strong> No verified audio or pronunciation grading. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><RoutineRoleplay client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Lesson completion is separate from your optional speaking and written quiz score.</p><LessonActions client:load lessonId="n5-m03-c02-l08" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">SPEAKING TIP</span><h3>Ask, answer, switch</h3><p>Listen to your own phrasing, and check time expressions, verb endings and particles against the printed model.</p></aside></div></section>
</Base>