---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RoutineKanjiPractice from '../../../../../components/interactive/RoutineKanjiPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/daily-routine-kanji');
if(!lesson||lesson.data.lessonId!=='n5-m03-c02-l04')throw new Error('Missing canonical lesson n5-m03-c02-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Daily routine verbs',href:'/learn/n5/module-03/chapter-02/lesson-04/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 03 · Chapter 02 · Lesson 04</span></nav><span class="eyebrow">N5 · MODULE 03 · CHAPTER 02 · LESSON 04</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Original written note</span><span>10 practice questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
<div class="course-notice"><strong>Original written lesson.</strong> No audio claimed. Independent Japanese and assessment reviews pending.</div>
<div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
<article class="lesson-article foundation-article"><Content/></article><RoutineKanjiPractice client:load/>
<div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from your practice score.</p><LessonActions client:load lessonId="n5-m03-c02-l04" level="n5"/></div>
<div class="lesson-next"><h3>Continue learning</h3><p>Next: reading a daily routine note.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
</div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Read the whole verb</h3><p>Notice both the kanji and kana ending. 見ます and 見ません have opposite polarity; 読みます and 書きます name different actions.</p></aside></div></section>
</Base>
