---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ScheduleCheckpoint from '../../../../../components/interactive/ScheduleCheckpoint';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/past-future-schedule-checkpoint');
if(!lesson||lesson.data.lessonId!=='n5-m03-c03-chk')throw new Error('Missing canonical checkpoint');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Past and future schedules',href:'/learn/n5/module-03/chapter-03/checkpoint/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 03 · CHAPTER 03 · CHECKPOINT</span><h1>Past and future schedules — chapter checkpoint</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Written and audio-gated practice</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original practice. Independent Japanese and assessment reviews pending. Audio scoring requires playable chapter WAVs.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><ScheduleCheckpoint client:load /><div class="foundation-completion"><h2>Complete the checkpoint</h2><p>Completion and question accuracy are stored separately.</p><LessonActions client:load lessonId="n5-m03-c03-chk" level="n5" /></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Review polite past endings, read Haru's calendar note, then listen to the two chapter conversations when audio is available.</p></aside></div></section>
</Base>