---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Workshop from '../../../../../components/interactive/TwoDayWritingWorkshop';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/two-day-plan-writing');
if (!lesson || lesson.data.lessonId !== 'n5-m03-c03-l07') throw new Error('Missing canonical two-day writing lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Past and future schedules',href:'/learn/n5/module-03/chapter-03/lesson-07/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 03 · CHAPTER 03 · LESSON 07</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Writing and typing</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy material. Independent Japanese and assessment reviews pending. Not official JLPT material.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Workshop client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Lesson completion and recognition attempts are stored separately on this device.</p><LessonActions client:load lessonId="n5-m03-c03-l07" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-03/chapter-03/lesson-06/">Previous: schedule listening</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Write a fictional note with yesterday's past verbs and tomorrow's nonpast plans. Free writing is self-reviewed.</p><p>No new audio is required for L07.</p></aside></div></section>
</Base>