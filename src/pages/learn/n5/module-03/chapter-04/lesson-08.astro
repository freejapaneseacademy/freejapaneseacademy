---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HabitRoleplay from '../../../../../components/interactive/HabitRoleplay';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/frequency-habits-roleplay');
if(!lesson||lesson.data.lessonId!=='n5-m03-c04-l08')throw new Error('Missing canonical lesson n5-m03-c04-l08');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Frequency and habits',href:'/learn/n5/module-03/chapter-04/lesson-08/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 03 · Chapter 04 · Lesson 08</span></nav><span class="eyebrow">N5 · MODULE 03 · CHAPTER 04 · LESSON 08</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Optional speaking</span><span>10 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Optional, private rehearsal.</strong> No audio or speech evaluation is provided; independent Japanese and assessment review pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HabitRoleplay client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from the written quiz score. Speaking is optional.</p><LessonActions client:load lessonId="n5-m03-c04-l08" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: chapter checkpoint for frequency and habits.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">SPEAKING GUIDE</span><h3>Switch and substitute</h3><p>Try a question, a positive reply and a negative reply. No microphone is needed.</p></aside></div></section>
</Base>