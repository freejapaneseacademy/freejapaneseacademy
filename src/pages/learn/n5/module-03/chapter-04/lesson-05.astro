---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import JournalReadingPractice from '../../../../../components/interactive/JournalReadingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/frequency-habit-journal-reading');
if(!lesson||lesson.data.lessonId!=='n5-m03-c04-l05')throw new Error('Missing canonical lesson n5-m03-c04-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Frequency and habits',href:'/learn/n5/module-03/chapter-04/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 03 · Chapter 04 · Lesson 05</span></nav><span class="eyebrow">N5 · MODULE 03 · CHAPTER 04 · LESSON 05</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written reading</span><span>10 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original fictional journal.</strong> Independent Japanese and assessment reviews pending; no audio or pronunciation score is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><JournalReadingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from your quiz score.</p><LessonActions client:load lessonId="n5-m03-c04-l05" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: listening to a habit survey.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Evidence first</h3><p>Check the frequency word and verb ending together. Do not invent details absent from the journal.</p></aside></div></section>
</Base>