---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import WorkshopNoticeWriting from '../../../../../components/interactive/WorkshopNoticeWriting';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/workshop-notice-writing');
if(!lesson||lesson.data.lessonId!=='n5-m03-c01-l07')throw new Error('Missing canonical lesson n5-m03-c01-l07');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Numbers, dates and counters',href:'/learn/n5/module-03/chapter-01/lesson-07/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 03 · Chapter 01 · Lesson 07</span></nav>
<span class="eyebrow">N5 · MODULE 03 · CHAPTER 01 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Original writing workshop</span><span>8 recognition questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
<div class="course-notice"><strong>Original written lesson.</strong> Free writing is ungraded; independent Japanese and assessment reviews pending.</div>
<div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
<article class="lesson-article foundation-article"><Content/></article><WorkshopNoticeWriting client:load/>
<div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from recognition score and self-reviewed writing.</p><LessonActions client:load lessonId="n5-m03-c01-l07" level="n5"/></div>
<div class="lesson-next"><h3>Continue learning</h3><p>Next: optional speaking rehearsal with a short event notice.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
</div><aside class="lesson-side foundation-side"><span class="eyebrow">WRITING GUIDE</span><h3>Four details, four checks</h3><p>Date + weekday; start time with から; quantity with the right counter; clear sentence endings.</p></aside></div></section>
</Base>
