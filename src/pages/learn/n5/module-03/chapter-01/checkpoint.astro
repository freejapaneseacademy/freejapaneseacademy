---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import DateCounterCheckpoint from '../../../../../components/interactive/DateCounterCheckpoint';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/numbers-dates-counters-checkpoint');
if(!lesson||lesson.data.lessonId!=='n5-m03-c01-chk')throw new Error('Missing canonical checkpoint n5-m03-c01-chk');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Numbers, dates and counters',href:'/learn/n5/module-03/chapter-01/checkpoint/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 03 · CHAPTER 01 · CHECKPOINT</span><h1>Numbers, dates and counters — chapter checkpoint</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Grammar, reading and listening</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Listening scoring requires playable licensed chapter recordings. Independent Japanese and pronunciation reviews remain pending.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><DateCounterCheckpoint client:load/><div class="foundation-completion"><h2>Complete the checkpoint</h2><p>Completion and assessment attempts are stored separately.</p><LessonActions client:load lessonId="n5-m03-c01-chk" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Read the two written notices. Then listen to the two different chapter announcements without transcripts, if verified audio is available.</p></aside></div></section>
</Base>