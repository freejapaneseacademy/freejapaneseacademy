---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import TimetableReading from '../../../../../components/interactive/TimetableReading';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/community-timetable-reading');
if(!lesson||lesson.data.lessonId!=='n5-m03-c01-l05')throw new Error('Missing canonical lesson n5-m03-c01-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Numbers, dates and counters',href:'/learn/n5/module-03/chapter-01/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 03 · Chapter 01 · Lesson 05</span></nav><span class="eyebrow">N5 · MODULE 03 · CHAPTER 01 · LESSON 05</span><h1>Read a community-center timetable</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Original written timetable</span><span>10 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original fictional reading.</strong> Independent Japanese and assessment reviews pending. No audio or pronunciation assessment is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><TimetableReading client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and reading score are recorded separately.</p><LessonActions client:load lessonId="n5-m03-c01-l05" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: recorded date announcements in Lesson 06, subject to verified audio availability.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">READING STRATEGY</span><h3>Follow a row</h3><p>Find the date or activity, then read across the matching row. Cite A–F and do not guess missing fees.</p></aside></div></section>
</Base>
