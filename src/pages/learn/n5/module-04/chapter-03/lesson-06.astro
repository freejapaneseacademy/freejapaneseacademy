---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import AdjectiveListeningPractice from '../../../../../components/interactive/AdjectiveListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/adjective-comparisons-listening');
if(!lesson||lesson.data.lessonId!=='n5-m04-c03-l06')throw new Error('Missing canonical adjective listening lesson');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Adjectives for descriptions',href:'/learn/n5/module-04/chapter-03/lesson-06/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 04 · CHAPTER 03 · LESSON 06</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Two original comparison scenes</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Synthetic audio must be generated and hash-verified before publication. Independent Japanese and pronunciation review pending; no official proficiency grade.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><AdjectiveListeningPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Lesson completion and unaided listening attempts are separate.</p><LessonActions client:load lessonId="n5-m04-c03-l06" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Listen first</h3><p>Track A: cafés and food. Track B: two bags and a final choice. Reveal transcripts only after listening.</p><p>Voices are synthetic; independent pronunciation review is pending.</p></aside></div></section>
</Base>
