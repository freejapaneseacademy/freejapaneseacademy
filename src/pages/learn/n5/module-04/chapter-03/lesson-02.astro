---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import DescriptionWordsPractice from '../../../../../components/interactive/DescriptionWordsPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/description-words-vocabulary');
if(!lesson || lesson.data.lessonId!=='n5-m04-c03-l02') throw new Error('Missing canonical lesson n5-m04-c03-l02');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Adjectives for descriptions',href:'/learn/n5/module-04/chapter-03/lesson-02/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 04 · CHAPTER 03 · LESSON 02</span><h1>Words for taste, size and evaluation</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Written vocabulary practice</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original Japanese teaching material. Independent Japanese and assessment reviews pending. No audio or pronunciation verification is claimed.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><DescriptionWordsPractice client:load/><div class="foundation-completion"><h2>Complete the lesson</h2><p>Completion and quiz attempts are recorded separately.</p><LessonActions client:load lessonId="n5-m04-c03-l02" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Compare taste, size and price descriptions, then answer twelve context questions.</p></aside></div></section>
</Base>
