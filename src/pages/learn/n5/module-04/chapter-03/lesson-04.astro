---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import AdjectiveKanjiPractice from '../../../../../components/interactive/AdjectiveKanjiPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/adjective-kanji-context');
if(!lesson)throw new Error('Missing n5-m04-c03-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Adjective kanji',href:'/learn/n5/module-04/chapter-03/lesson-04/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 04 · CHAPTER 03 · LESSON 04</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Kanji recognition · adjectives · reading</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original Japanese lesson.</strong> Internal screening is not independent Japanese-language review. Not official JLPT material.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><AdjectiveKanjiPractice client:load /><div class="foundation-completion"><h2>Finish this lesson</h2><p>Mark completion separately from quiz accuracy. Optional speaking is never required.</p><LessonActions client:load lessonId="n5-m04-c03-l04" level="n5" /></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Adjective kanji</h3><p>大・小・高・安・新・古 in useful words.</p><ol><li>Read complete words.</li><li>Compare original shop cards.</li><li>Check meaning in context.</li><li>Write and self-review.</li></ol><p>Written lesson; no recording required.</p></aside></div></section>
</Base>