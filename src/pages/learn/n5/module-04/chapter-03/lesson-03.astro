---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/AdjectiveGrammarPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'n5/adjectives-grammar');
if (!lesson || lesson.data.lessonId !== 'n5-m04-c03-l03') throw new Error('Missing canonical adjective grammar lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Adjective grammar',href:'/learn/n5/module-04/chapter-03/lesson-03/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 04 · CHAPTER 03 · LESSON 03</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Grammar and sentence function</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
<div class="course-notice">Original academy lesson. Independent Japanese and assessment reviews pending. Not official JLPT material.</div>
<div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
<article class="lesson-article foundation-article"><Content /></article>
<Practice client:load />
<div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are saved on this device where browser storage is available.</p><LessonActions client:load lessonId="n5-m04-c03-l03" level="n5"/></div>
<div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-04/chapter-03/lesson-02/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div>
</div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Look for い-adjective endings, な before nouns, and the two negative patterns.</p><p>Reading and writing are practised here; this written grammar lesson does not claim recorded listening.</p></aside></div></section>
</Base>
