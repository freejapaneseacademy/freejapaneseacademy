---
import Base from '../../../../../../layouts/Base.astro';
import {getEntry,render} from 'astro:content';
import LessonActions from '../../../../../../components/interactive/LessonActions';
import ShoppingWritingPractice from '../../../../../../components/interactive/ShoppingWritingPractice';
const lesson=await getEntry('lessons','n5/shopping-request-writing');
if(!lesson)throw new Error('Missing canonical n5-m04-c02-l07 content');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 04 · CHAPTER 02 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="hero-meta"><span>25 minutes</span><span>Writing and typing</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original writing lesson.</strong> Fictional prices and people. Independent Japanese and assessment review pending. Free composition is self-reviewed, not graded.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><ShoppingWritingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from the controlled quiz score and your writing self-review.</p><LessonActions client:load lessonId="n5-m04-c02-l07" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: optional shopping speaking and shadowing.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Polite shopping writing</h3><p>Ask with いくらですか, answer with a price in 円, then request with をお願いします or をください.</p></aside></div></section>
</Base>
