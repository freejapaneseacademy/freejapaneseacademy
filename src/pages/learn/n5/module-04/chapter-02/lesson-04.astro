---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ShoppingKanjiPractice from '../../../../../components/interactive/ShoppingKanjiPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/shopping-prices-kanji');
if(!lesson||lesson.data.lessonId!=='n5-m04-c02-l04')throw new Error('Missing canonical lesson n5-m04-c02-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Shopping and prices',href:'/learn/n5/module-04/chapter-02/lesson-04/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 04 · Chapter 02 · Lesson 04</span></nav><span class="eyebrow">N5 · MODULE 04 · CHAPTER 02 · LESSON 04</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written kanji recognition</span><span>12 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written lesson.</strong> Fictional labels; independent Japanese and assessment review pending. No audio or pronunciation score is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><ShoppingKanjiPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from your quiz score.</p><LessonActions client:load lessonId="n5-m04-c02-l04" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: reading original shopping price labels.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Read the whole word</h3><p>大きい is おおきい; 小さい is ちいさい. Read kanji in context, not by guessing one fixed sound.</p></aside></div></section>
</Base>