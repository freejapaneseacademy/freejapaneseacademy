---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import FoodWritingPractice from '../../../../../components/interactive/FoodWritingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/food-drinks-writing');
if(!lesson||lesson.data.lessonId!=='n5-m04-c01-l07')throw new Error('Missing canonical lesson n5-m04-c01-l07');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Food and drinks',href:'/learn/n5/module-04/chapter-01/lesson-07/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 04 · Chapter 01 · Lesson 07</span></nav><span class="eyebrow">N5 · MODULE 04 · CHAPTER 01 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Writing / typing</span><span>10 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Independent writing.</strong> Your draft is not automatically graded. Qualified Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><FoodWritingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from your quiz score and your self-review.</p><LessonActions client:load lessonId="n5-m04-c01-l07" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: optional café speaking roleplay.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">WRITING GUIDE</span><h3>Three useful particles</h3><p>パン<strong>が</strong>好きです。パン<strong>を</strong>食べます。友だち<strong>と</strong>食べます。</p></aside></div></section>
</Base>