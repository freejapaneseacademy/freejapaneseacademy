---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import CafeListeningPractice from '../../../../../components/interactive/CafeListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/food-drinks-listening');
if(!lesson||lesson.data.lessonId!=='n5-m04-c01-l06')throw new Error('Missing canonical café listening lesson');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Food and drinks',href:'/learn/n5/module-04/chapter-01/lesson-06/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 04 · CHAPTER 01 · LESSON 06</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Two listening scenes</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Audio must be genuinely generated and verified before release. Independent Japanese and pronunciation review pending. No official JLPT grade.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><CafeListeningPractice client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and unaided listening scores are stored separately on this device.</p><LessonActions client:load lessonId="n5-m04-c01-l06" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Listening guide</h3><p>Listen first. Reveal the transcript only when ready for assisted review. The two speakers make different choices.</p><p>Audio is synthetic; independent pronunciation review is pending.</p></aside></div></section>
</Base>
