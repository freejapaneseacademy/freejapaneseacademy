---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import CafeContextPractice from '../../../../../components/interactive/CafeContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/food-drinks-cafe-context');
if(!lesson||lesson.data.lessonId!=='n5-m04-c01-l01')throw new Error('Missing canonical lesson n5-m04-c01-l01');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Food and drinks',href:'/learn/n5/module-04/chapter-01/lesson-01/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 04 · Chapter 01 · Lesson 01</span></nav><span class="eyebrow">N5 · MODULE 04 · CHAPTER 01 · LESSON 01</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Context and meaning</span><span>10 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written scenario.</strong> Fictional characters; independent Japanese and assessment reviews pending. No recorded audio or pronunciation grade is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><CafeContextPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from your quiz score.</p><LessonActions client:load lessonId="n5-m04-c01-l01" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: foods, drinks, and meals vocabulary.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Preference or order?</h3><p>パンが好きです expresses liking. パンを食べます describes eating. コーヒーと水 joins two ordered drinks.</p></aside></div></section>
</Base>
