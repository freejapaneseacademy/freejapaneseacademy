---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import InvitationWordsPractice from '../../../../../components/interactive/InvitationWordsPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/invitation-planning-vocabulary');
if(!lesson || lesson.data.lessonId!=='n5-m04-c04-l02') throw new Error('Missing canonical lesson n5-m04-c04-l02');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Invitations and decisions',href:'/learn/n5/module-04/chapter-04/lesson-02/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 04 · CHAPTER 04 · LESSON 02</span><h1>Make a plan: invitations and places</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Vocabulary and reading</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original written lesson. Independent Japanese-language and assessment review pending. No recorded pronunciation evaluation claimed.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><InvitationWordsPractice client:load/><div class="foundation-completion"><h2>Complete the lesson</h2><p>Completion and practice accuracy are stored separately.</p><LessonActions client:load lessonId="n5-m04-c04-l02" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Review planning words, identify a proposed day and meeting place, then practise accepting or declining politely.</p></aside></div></section>
</Base>
