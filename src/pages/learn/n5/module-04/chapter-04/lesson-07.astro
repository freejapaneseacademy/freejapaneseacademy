---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import InvitationWritingPractice from '../../../../../components/interactive/InvitationWritingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/invitation-writing');
if (!lesson || lesson.data.lessonId !== 'n5-m04-c04-l07') throw new Error('Missing canonical lesson n5-m04-c04-l07');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Invitations and decisions',href:'/learn/n5/module-04/chapter-04/lesson-07/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 04 · Chapter 04 · Lesson 07</span></nav><span class="eyebrow">N5 · MODULE 04 · CHAPTER 04 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Writing and typing</span><span>10 language checks</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written lesson.</strong> Fictional scenarios; independent Japanese and assessment review pending. No handwriting, speaking or pronunciation grade is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><InvitationWritingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Lesson completion is separate from the fixed-answer score and self-reviewed writing.</p><LessonActions client:load lessonId="n5-m04-c04-l07" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: optional invitation speaking in Lesson 08.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">WRITING STRATEGY</span><h3>Invite · meet · reply</h3><p>Include a day, action, time and meeting point. Check ませんか, ましょう, and the meeting-place particle で. Read your reply for politeness.</p></aside></div></section>
</Base>
