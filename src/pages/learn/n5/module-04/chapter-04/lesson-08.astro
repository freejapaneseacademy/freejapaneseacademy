---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/InvitationRoleplayPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/invitations-roleplay');
if (!lesson || lesson.data.lessonId !== 'n5-m04-c04-l08') throw new Error('Missing canonical invitation role-play lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Invitations and decisions',href:'/learn/n5/module-04/chapter-04/lesson-08/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 04 · CHAPTER 04 · OPTIONAL LESSON 08</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Optional speaking and role switching</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
<div class="course-notice">Original academy lesson. Optional speaking is ungraded; no microphone is accessed. Independent Japanese and assessment reviews pending. Not official JLPT material.</div>
<div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
<article class="lesson-article foundation-article"><Content /></article>
<Practice client:load />
<div class="foundation-completion"><h2>Finish this optional lesson</h2><p>You may mark this lesson complete or skip it. Written quiz attempts and completion are saved on this device where browser storage is available.</p><LessonActions client:load lessonId="n5-m04-c04-l08" level="n5"/></div>
<div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-04/chapter-04/lesson-07/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div>
</div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Invite: ませんか. Accept: ましょう. Choose: にします. Decline: 今日はちょっと…….</p><p>Practice both roles. This page does not record or evaluate speech.</p></aside></div></section>
</Base>
