---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import CompanionsItineraryReading from '../../../../../components/interactive/CompanionsItineraryReading';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'n5/travel-companions-itinerary-reading');
if (!lesson || lesson.data.lessonId !== 'n5-m05-c02-l05') throw new Error('Missing canonical reading lesson n5-m05-c02-l05');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Methods and companions',href:'/learn/n5/module-05/chapter-02/lesson-05/'}]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 05 · Chapter 02 · Lesson 05</span></nav>
    <span class="eyebrow">N5 · MODULE 05 · CHAPTER 02 · LESSON 05</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Original trip itinerary</span><span>12 reading questions</span></div></div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original written lesson.</strong> Fictional itinerary; independent Japanese and assessment reviews pending. No audio or pronunciation grade is claimed.</div>
    <div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string) => <li>{o}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <CompanionsItineraryReading client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from quiz score.</p><LessonActions client:load lessonId="n5-m05-c02-l05" level="n5" /></div>
    <div class="lesson-next"><h3>Keep learning</h3><p>Next: listening to a planning conversation in L06 when verified audio is available.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">READING STRATEGY</span><h3>Person, vehicle, companion</h3><p>Find a precise Japanese phrase for each answer. Distinguish means で from location で.</p></aside></div></section>
</Base>
