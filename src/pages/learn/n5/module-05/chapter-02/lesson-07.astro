---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import TravelWritingPractice from '../../../../../components/interactive/TravelWritingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/travel-companions-writing');
if(!lesson || lesson.data.lessonId!=='n5-m05-c02-l07')throw new Error('Missing canonical lesson n5-m05-c02-l07');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Methods and companions',href:'/learn/n5/module-05/chapter-02/lesson-07/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 05 · CHAPTER 02 · LESSON 07</span><h1>Write a travel plan</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Writing / typing</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
<div class="course-notice">Original written lesson. Independent Japanese-language and assessment reviews pending. Open writing is self-reviewed, not automatically graded.</div>
<div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
<article class="lesson-article foundation-article"><Content/></article>
<TravelWritingPractice client:load/>
<div class="foundation-completion"><h2>Complete the lesson</h2><p>Lesson completion and pattern quiz results are stored separately.</p><LessonActions client:load lessonId="n5-m05-c02-l07" level="n5"/></div>
<div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div>
</div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Choose a destination, identify your companion or say you are alone, then state your transport. Revise rather than chasing an automatic writing score.</p></aside></div></section>
</Base>