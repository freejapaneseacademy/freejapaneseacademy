---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/CompanionChapterCheckpoint';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/methods-companions-checkpoint');
if(!lesson||lesson.data.lessonId!=='n5-m05-c02-chk')throw new Error('Missing canonical methods and companions checkpoint');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Companions checkpoint',href:'/learn/n5/module-05/chapter-02/checkpoint/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 05 · CHAPTER 02 · CHECKPOINT</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Chapter checkpoint</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy material. Independent Japanese and assessment reviews pending. Not official JLPT material.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load/><div class="foundation-completion"><h2>Finish the checkpoint</h2><p>Completion and quiz attempts are saved on this device when available.</p><LessonActions client:load lessonId="n5-m05-c02-chk" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-05/chapter-02/lesson-08/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Distinguish transport で, companion と, and 一人で.</p><p>Written questions do not substitute for real listening.</p></aside></div></section>
</Base>
