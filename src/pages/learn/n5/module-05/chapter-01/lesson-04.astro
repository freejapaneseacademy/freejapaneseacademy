---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import JourneyKanjiPractice from '../../../../../components/interactive/JourneyKanjiPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/journey-kanji');
if(!lesson||lesson.data.lessonId!=='n5-m05-c01-l04')throw new Error('Missing canonical lesson n5-m05-c01-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Going and coming',href:'/learn/n5/module-05/chapter-01/lesson-04/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 05 · CHAPTER 01 · LESSON 04</span><h1>Kanji for a journey</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Written kanji recognition</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original written lesson. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><JourneyKanjiPractice client:load/><div class="foundation-completion"><h2>Complete the lesson</h2><p>Completion and practice scores are stored separately.</p><LessonActions client:load lessonId="n5-m05-c01-l04" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Read whole words, notice different readings of 車, and track destinations.</p></aside></div></section>
</Base>