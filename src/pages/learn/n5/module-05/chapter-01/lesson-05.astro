---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RouteReadingPractice from '../../../../../components/interactive/RouteReadingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/going-coming-route-reading');
if(!lesson||lesson.data.lessonId!=='n5-m05-c01-l05')throw new Error('Missing canonical reading lesson n5-m05-c01-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Going and coming',href:'/learn/n5/module-05/chapter-01/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 05 · Chapter 01 · Lesson 05</span></nav><span class="eyebrow">N5 · MODULE 05 · CHAPTER 01 · LESSON 05</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Original route-plan reading</span><span>12 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written lesson.</strong> Fictional itinerary; independent Japanese and assessment reviews pending. No listening or pronunciation grade is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><RouteReadingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from quiz score.</p><LessonActions client:load lessonId="n5-m05-c01-l05" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: listen to a travel conversation in L06 after authentic recordings are available.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">READING STRATEGY</span><h3>Prove each answer</h3><p>Locate the time, destination, transport and action. Quote the Japanese evidence before choosing.</p></aside></div></section>
</Base>