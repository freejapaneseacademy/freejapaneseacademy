---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/DirectionReadingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/directions-map-reading');
if(!lesson||lesson.data.lessonId!=='n5-m05-c03-l05')throw new Error('Missing canonical directions reading lesson');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Directions reading',href:'/learn/n5/module-05/chapter-03/lesson-05/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 05 · CHAPTER 03 · LESSON 05</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Reading practice</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original fictional route. Independent Japanese and assessment reviews pending. Not official JLPT material.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and quiz attempts are saved on this device when available.</p><LessonActions client:load lessonId="n5-m05-c03-l05" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-05/chapter-03/lesson-04/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Reading strategy</h3><p>Find the verb for each instruction, then identify landmarks using あります.</p><p>Listening practice uses authentic recordings in L06; this page tests written evidence only.</p></aside></div></section>
</Base>