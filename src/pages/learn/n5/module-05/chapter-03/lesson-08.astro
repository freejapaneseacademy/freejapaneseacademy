---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/DirectionsRoleplayPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/directions-street-roleplay');
if (!lesson || lesson.data.lessonId !== 'n5-m05-c03-l08') throw new Error('Missing canonical lesson n5-m05-c03-l08');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Directions role play',href:'/learn/n5/module-05/chapter-03/lesson-08/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 05 · CHAPTER 03 · OPTIONAL LESSON 08</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Optional speaking and role switch</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Optional speaking rehearsal. No microphone access or pronunciation scoring. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><Practice client:load/><div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Completion and written attempts are saved on this device when available.</p><LessonActions client:load lessonId="n5-m05-c03-l08" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-05/chapter-03/lesson-07/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Directions toolkit</h3><p>Ask: どこですか. Guide: まっすぐ行ってください, 右・左に曲がってください. Locate: 隣にあります.</p><p>Written models are not substitutes for verified audio.</p></aside></div></section>
</Base>