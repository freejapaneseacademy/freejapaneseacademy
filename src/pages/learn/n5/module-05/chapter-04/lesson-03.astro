---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/TravelPlanParticlesPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/travel-plan-particles');
if(!lesson) throw new Error('Missing n5-m05-c04-l03');
const { Content }=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Travel plans and review',href:'/learn/n5/module-05/chapter-04/lesson-03/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 05 · CHAPTER 04 · LESSON 03</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Grammar and sentence function</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original FreeJapaneseAcademy material. Independent Japanese-language and assessment reviews pending; not official JLPT material.</div><div class="lesson-intro"><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load /><div class="foundation-completion"><h2>Finish this lesson</h2><p>Lesson completion and written quiz scores are recorded separately.</p><LessonActions client:load lessonId="n5-m05-c04-l03" level="n5" /></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Mark time, meeting point, destination, origin and means separately before joining sentences.</p><p>Written grammar lesson: audio is not required.</p></aside></div></section>
</Base>