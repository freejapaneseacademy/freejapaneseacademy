---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ReusableListeningPractice from '../../../../../components/interactive/ReusableListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import bank from '../../../../../content/exercises/n5-m05-c04-l06-v1.json';
import manifest from '../../../../../content/audio/n5-m05-c04-l06-v1.json';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/travel-outing-listening');
if(!lesson||lesson.data.lessonId!=='n5-m05-c04-l06')throw new Error('Missing canonical lesson n5-m05-c04-l06');
const {Content}=await render(lesson);
const tracks=manifest.assets.map((asset:any,index:number)=>({id:index===0?'a':'b',assetId:asset.id,label:index===0?'Meeting for the museum visit':'Sunday bus trip to the aquarium',url:asset.mediaPath,durationSeconds:asset.durationSeconds,transcript:asset.transcript,english:asset.english}));
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Itinerary listening',href:'/learn/n5/module-05/chapter-04/lesson-06/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 05 · Chapter 04 · Lesson 06</span></nav><span class="eyebrow">N5 · LISTENING · LESSON 06</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>2 synthetic Japanese dialogues</span><span>{bank.items.length} audible questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Synthetic Japanese dialogues.</strong> Independent pronunciation and assessment review pending; assisted attempts are not saved as blind listening scores.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><ReusableListeningPractice client:load lessonId="n5-m05-c04-l06" level="n5" version={1} tracks={tracks} questions={bank.items}/><div class="foundation-completion"><h2>Finish this lesson</h2><LessonActions client:load lessonId="n5-m05-c04-l06" level="n5"/></div></div><aside class="lesson-side foundation-side"><h3>Listen before reading</h3><p>Keep transcripts hidden for an unaided listening score. You can replay either recording.</p></aside></div></section>
</Base>
