---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/OutingRoleplayPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/travel-outing-roleplay');
if (!lesson || lesson.data.lessonId !== 'n5-m05-c04-l08') throw new Error('Missing canonical lesson n5-m05-c04-l08');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Outing role play',href:'/learn/n5/module-05/chapter-04/lesson-08/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 05 · CHAPTER 04 · OPTIONAL LESSON 08</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Optional role-switch rehearsal</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Optional speaking. Printed models only; no microphone or automatic pronunciation grade. Independent language and assessment reviews pending.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><Practice client:load/><div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Completion and written attempts are stored locally when supported.</p><LessonActions client:load lessonId="n5-m05-c04-l08" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-05/chapter-04/lesson-07/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Planning toolkit</h3><p>Invite: いっしょに行きませんか。 Meet: 九時半に駅で会いましょう。 Travel: 電車で行きます。</p><p>One-way fare: 片道. The L06 lesson is the chapter's separate source of authentic listening audio.</p></aside></div></section>
</Base>
