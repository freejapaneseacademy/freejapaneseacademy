---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ExistenceVocabularyPractice from '../../../../../components/interactive/ExistenceVocabularyPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/existence-vocabulary');
if(!lesson || lesson.data.lessonId!=='n5-m02-c03-l02')throw new Error('Missing canonical lesson n5-m02-c03-l02');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Existence and location',href:'/learn/n5/module-02/chapter-03/lesson-02/'}]}>
<section class="page-hero"><div class="container">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 02 · Chapter 03 · Lesson 02</span></nav>
<span class="eyebrow">N5 · MODULE 02 · CHAPTER 03 · LESSON 02</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p>
<div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written vocabulary study</span><span>12 questions</span></div>
</div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
<div class="course-notice"><strong>Original written lesson.</strong> Fictional scenes; independent Japanese and assessment reviews pending. No audio or pronunciation grade is claimed.</div>
<div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
<article class="lesson-article foundation-article"><Content/></article>
<ExistenceVocabularyPractice client:load/>
<div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from the written quiz score.</p><LessonActions client:load lessonId="n5-m02-c03-l02" level="n5"/></div>
<div class="lesson-next"><h3>Keep learning</h3><p>Next: あります／います and the location particle に in complete sentences.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
</div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>People, animals, objects</h3><p>Group nouns by meaning before choosing います or あります. Use the kana readings to check unfamiliar kanji.</p></aside></div></section>
</Base>