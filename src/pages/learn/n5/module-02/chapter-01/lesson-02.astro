---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ObjectVocabularyPractice from '../../../../../components/interactive/ObjectVocabularyPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/objects-ownership-vocabulary');
if(!lesson || lesson.data.lessonId!=='n5-m02-c01-l02') throw new Error('Missing canonical lesson n5-m02-c01-l02');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Objects and ownership',href:'/learn/n5/module-02/chapter-01/lesson-02/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 02 · CHAPTER 01 · LESSON 02</span><h1>School supplies at the lost-and-found desk</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Written vocabulary practice</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original written Japanese lesson. Independent language and assessment review pending. No audio or pronunciation verification is claimed.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><ObjectVocabularyPractice client:load/><div class="foundation-completion"><h2>Complete the lesson</h2><p>Lesson completion and written question accuracy are recorded separately.</p><LessonActions client:load lessonId="n5-m02-c01-l02" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Read eight words, compare them in sentences, rehearse an exchange, then check recall.</p></aside></div></section>
</Base>