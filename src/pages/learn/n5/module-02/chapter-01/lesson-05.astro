---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import LostFoundReadingPractice from '../../../../../components/interactive/LostFoundReadingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/lost-found-notices-reading');
if(!lesson||lesson.data.lessonId!=='n5-m02-c01-l05')throw new Error('Missing canonical lesson n5-m02-c01-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Objects and ownership',href:'/learn/n5/module-02/chapter-01/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 02 · Chapter 01 · Lesson 05</span></nav><span class="eyebrow">N5 · MODULE 02 · CHAPTER 01 · LESSON 05</span><h1>Read two lost-and-found notes</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written evidence reading</span><span>10 practice questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written reading lesson.</strong> Two fictional school notices; independent Japanese and assessment review pending. No audio is assessed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><LostFoundReadingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from the written quiz score.</p><LessonActions client:load lessonId="n5-m02-c01-l05" level="n5"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: listening to an object dialogue with verified audio.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Quote the evidence</h3><p>Locate the object, match its owner, and quote the exact Japanese sentence. Unknown ownership is a valid answer.</p></aside></div></section>
</Base>