---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ObjectListeningPractice from '../../../../../components/interactive/N5ObjectListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/objects-ownership-listening');
if(!lesson||lesson.data.lessonId!=='n5-m02-c01-l06')throw new Error('Missing canonical lesson n5-m02-c01-l06');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Objects and ownership',href:'/learn/n5/module-02/chapter-01/lesson-06/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 02 · CHAPTER 01 · LESSON 06</span><h1>Listening: whose belongings?</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Listening comprehension</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Synthetic Japanese dialogue. Independent pronunciation and assessment review pending; audio must pass verification before release.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><ObjectListeningPractice client:load/><div class="foundation-completion"><h2>Complete the lesson</h2><p>Completion and listening accuracy are recorded separately.</p><LessonActions client:load lessonId="n5-m02-c01-l06" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Listen blind, answer, reveal transcript only when needed, and verify spoken evidence.</p></aside></div></section>
</Base>