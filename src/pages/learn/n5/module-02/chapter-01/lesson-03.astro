---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ObjectOwnershipGrammarPractice from '../../../../../components/interactive/ObjectOwnershipGrammarPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/objects-ownership-grammar');
if(!lesson || lesson.data.lessonId!=='n5-m02-c01-l03') throw new Error('Missing canonical lesson n5-m02-c01-l03');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Objects and ownership',href:'/learn/n5/module-02/chapter-01/lesson-03/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 02 · CHAPTER 01 · LESSON 03</span><h1>Demonstratives and ownership</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Written grammar and reading</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original written lesson. Independent Japanese-language and assessment review pending. No audio or pronunciation verification claimed.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><ObjectOwnershipGrammarPractice client:load/><div class="foundation-completion"><h2>Complete the lesson</h2><p>Lesson completion and written accuracy are recorded separately.</p><LessonActions client:load lessonId="n5-m02-c01-l03" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Compare pointing words, ask whose an object is, read the exchange, then practise.</p></aside></div></section>
</Base>