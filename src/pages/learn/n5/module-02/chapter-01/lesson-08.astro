---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import OwnershipRoleplay from '../../../../../components/interactive/OwnershipRoleplay';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/ownership-roleplay');
if(!lesson||lesson.data.lessonId!=='n5-m02-c01-l08')throw new Error('Missing canonical lesson n5-m02-c01-l08');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Objects and ownership',href:'/learn/n5/module-02/chapter-01/lesson-08/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 02 · Chapter 01 · Lesson 08</span></nav><span class="eyebrow">N5 · MODULE 02 · CHAPTER 01 · OPTIONAL LESSON 08</span><h1>Lost-and-found role switching</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Optional speaking</span><span>8 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Optional, ungraded oral practice.</strong> Original written model scenes, no dedicated recording or microphone access. Independent Japanese review pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><OwnershipRoleplay client:load/><div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Completion is separate from written accuracy and optional oral rehearsal.</p><LessonActions client:load lessonId="n5-m02-c01-l08" level="n5"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Whose is it?</h3><p>Point to the item, ask だれのですか, answer with a name + のです, then switch roles.</p></aside></div></section>
</Base>