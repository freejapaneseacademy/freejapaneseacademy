---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import PlacesGrammarPractice from '../../../../../components/interactive/PlacesGrammarPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/places-directions-grammar');
if(!lesson || lesson.data.lessonId!=='n5-m02-c02-l03') throw new Error('Missing canonical lesson n5-m02-c02-l03');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Places and directions',href:'/learn/n5/module-02/chapter-02/lesson-03/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 02 · CHAPTER 02 · LESSON 03</span><h1>Places and directions</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Written grammar and reading</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original written lesson. Independent Japanese-language and assessment review pending. No recorded pronunciation evaluation claimed.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><PlacesGrammarPractice client:load/><div class="foundation-completion"><h2>Complete the lesson</h2><p>Completion and practice accuracy are stored separately.</p><LessonActions client:load lessonId="n5-m02-c02-l03" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Ask where a facility is, choose a location word, read the conversation and practise.</p></aside></div></section>
</Base>