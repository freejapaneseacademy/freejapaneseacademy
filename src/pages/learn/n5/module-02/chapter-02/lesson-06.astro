---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import PlacesListeningPractice from '../../../../../components/interactive/PlacesListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/places-directions-listening');
if(!lesson||lesson.data.lessonId!=='n5-m02-c02-l06')throw new Error('Missing canonical lesson n5-m02-c02-l06');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Places and directions',href:'/learn/n5/module-02/chapter-02/lesson-06/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 02 · CHAPTER 02 · LESSON 06</span><h1>Places and directions — listening</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Two original spoken conversations</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Candidate licensed audio is generated and verified separately. Independent Japanese-language and pronunciation reviews pending; listening scoring locks when audio is unavailable.</div><div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><PlacesListeningPractice client:load/><div class="foundation-completion"><h2>Complete the lesson</h2><p>Completion and listening accuracy are stored separately.</p><LessonActions client:load lessonId="n5-m02-c02-l06" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 course</a><a class="btn btn-outline" href="/dashboard/">Progress dashboard</a></div></div><aside class="lesson-side foundation-side"><h2>Study guide</h2><p>Listen without the transcript, note each location, then check the spoken evidence.</p></aside></div></section>
</Base>