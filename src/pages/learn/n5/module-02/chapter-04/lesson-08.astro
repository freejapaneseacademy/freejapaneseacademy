---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RoomTourRoleplay from '../../../../../components/interactive/RoomTourRoleplay';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/room-tour-roleplay');
if(!lesson||lesson.data.lessonId!=='n5-m02-c04-l08') throw new Error('Missing canonical lesson n5-m02-c04-l08');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Describing a room',href:'/learn/n5/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 02 · Chapter 04 · Lesson 08</span></nav><span class="eyebrow">N5 · MODULE 02 · CHAPTER 04 · OPTIONAL LESSON 08</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Optional speaking</span><span>8 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Optional speaking, no automatic oral grade.</strong> This page uses original written models, not an embedded recording. Audio rehearsal belongs to the separately verified L06 lesson.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map(o=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><RoomTourRoleplay client:load/><div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Completion is independent of quiz accuracy or spoken performance.</p><LessonActions client:load lessonId="n5-m02-c04-l08" level="n5"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Location pattern</h3><p>Reference noun + の + position + に. Use あります for objects and います for living beings.</p></aside></div></section>
</Base>
