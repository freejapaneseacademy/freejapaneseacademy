---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ActionVerbSpeakingPractice from '../../../../../components/interactive/ActionVerbSpeakingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'n5/action-verb-speaking');
if (!lesson || lesson.data.lessonId !== 'n5-m06-c01-l08') throw new Error('Missing canonical lesson n5-m06-c01-l08');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Optional action-verb speaking',href:'/learn/n5/module-06/chapter-01/lesson-08/'}]}>
  <section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 06 · CHAPTER 01 · OPTIONAL LESSON 08</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Optional speaking</span><span>12 written questions</span></div></div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Optional, ungraded speaking.</strong> Printed model conversations; no new audio, microphone, or pronunciation verification is claimed. The separate L06 listening lesson supplies chapter audio.</div>
    <div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map(o=><li>{o}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <ActionVerbSpeakingPractice client:load />
    <div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Completion and written quiz attempts are distinct and saved locally when supported.</p><LessonActions client:load lessonId="n5-m06-c01-l08" level="n5"/></div>
    <div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-06/chapter-01/lesson-07/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div>
  </div><aside class="lesson-side foundation-side"><h3>Verb-pair reminder</h3><p>Group 1: 読む → 読みます. Group 2: 見る → 見ます. Group 3: する → します, 来る → 来ます.</p><p>Exception: 帰る is Group 1. A written quiz is not a speaking score.</p></aside></div></section>
</Base>
