---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import VerbKanjiPractice from '../../../../../components/interactive/VerbKanjiPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/verb-dictionary-kanji');
if(!lesson||lesson.data.lessonId!=='n5-m06-c01-l04')throw new Error('Missing canonical lesson n5-m06-c01-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Verb groups and dictionary form',href:'/learn/n5/module-06/chapter-01/lesson-04/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 06 · Chapter 01 · Lesson 04</span></nav><span class="eyebrow">N5 · MODULE 06 · CHAPTER 01 · LESSON 04</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written kanji study</span><span>12 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written lesson.</strong> Fictional activity list; independent Japanese and assessment reviews pending. No recorded audio or pronunciation grade is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><VerbKanjiPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from the quiz score.</p><LessonActions client:load lessonId="n5-m06-c01-l04" level="n5"/></div><div class="lesson-next"><h3>Keep learning</h3><p>Next: reading an action-verb list for evidence.</p><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Read whole verbs</h3><p>Use kanji plus okurigana to distinguish dictionary forms and ます forms.</p></aside></div></section>
</Base>