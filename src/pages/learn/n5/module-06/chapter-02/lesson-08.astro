---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import TeFormRoleplay from '../../../../../components/interactive/TeFormRoleplay';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/te-form-cooking-roleplay');
if(!lesson||lesson.data.lessonId!=='n5-m06-c02-l08')throw new Error('Missing canonical lesson n5-m06-c02-l08');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'The te-form',href:'/learn/n5/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 06 · Chapter 02 · Lesson 08</span></nav><span class="eyebrow">N5 · MODULE 06 · CHAPTER 02 · OPTIONAL LESSON 08</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Optional speaking</span><span>8 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Optional, ungraded speaking.</strong> Written models only. No verified recording or automated pronunciation grade.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map(o=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><TeFormRoleplay client:load/><div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Completion is independent of quiz accuracy and optional oral rehearsal.</p><LessonActions client:load lessonId="n5-m06-c02-l08" level="n5"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/n5/">N5 lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Remember the order</h3><p>まず → 次に → それから → 最後に. 〜てください requests an action; 〜てから highlights what happens after it.</p></aside></div></section>
</Base>