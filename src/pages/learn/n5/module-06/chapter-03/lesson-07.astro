---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Writing from '../../../../../components/interactive/RequestsPermissionWriting';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/requests-permission-writing');
if (!lesson) throw new Error('Missing n5-m06-c03-l07');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Requests and permission',href:'/learn/n5/module-06/chapter-03/lesson-07/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 06 · CHAPTER 03 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Writing and typing</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original FreeJapaneseAcademy material. Independent Japanese-language and assessment reviews pending; not official JLPT material.</div><div class="lesson-intro"><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Writing client:load /><div class="foundation-completion"><h2>Finish this lesson</h2><p>Lesson completion and recognition quiz attempts are stored separately. Your writing is self-reviewed, not graded.</p><LessonActions client:load lessonId="n5-m06-c03-l07" level="n5" /></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Writing guide</h3><p>Write 2–5 connected sentences, then use the five-criterion rubric to revise.</p><p>No microphone or external writing submission is needed.</p></aside></div></section>
</Base>