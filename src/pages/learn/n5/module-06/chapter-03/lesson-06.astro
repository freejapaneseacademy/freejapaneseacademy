---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RequestListeningPractice from '../../../../../components/interactive/RequestListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/requests-permission-listening');
if(!lesson || lesson.data.lessonId !== 'n5-m06-c03-l06') throw new Error('Missing canonical lesson n5-m06-c03-l06');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Requests and permission listening',href:'/learn/n5/module-06/chapter-03/lesson-06/'}]}>
 <section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 06 · CHAPTER 03 · LESSON 06</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Listening comprehension</span><span>2 scenes · 6 questions</span></div></div></section>
 <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
 <div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map(o=><li>{o}</li>)}</ul></div>
 <article class="lesson-article foundation-article"><Content /></article>
 <RequestListeningPractice client:load />
 <div class="foundation-completion"><h2>Finish the lesson</h2><p>Lesson completion is stored separately from listening attempts on this device.</p><LessonActions client:load lessonId="n5-m06-c03-l06" level="n5"/></div>
 <div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-06/chapter-03/lesson-05/">Previous reading lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div>
 </div><aside class="lesson-side foundation-side"><h3>Listen for the ending</h3><p>〜てもいいですか asks permission; 〜てください requests action; 〜てはいけません forbids it.</p><p>Audio must be verified before scoring. Transcript reveal makes an attempt assisted.</p></aside></div></section>
</Base>