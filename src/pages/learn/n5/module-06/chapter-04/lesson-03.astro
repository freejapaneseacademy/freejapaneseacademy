---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import OngoingGrammarPractice from '../../../../../components/interactive/OngoingGrammarPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/ongoing-activities-grammar');
if(!lesson||lesson.data.lessonId!=='n5-m06-c04-l03') throw new Error('Missing canonical lesson n5-m06-c04-l03');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Ongoing activities',href:'/learn/n5/module-06/chapter-04/lesson-03/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 06 · CHAPTER 04 · LESSON 03</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Grammar and sentence function</span><span>12 recognition questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
<div class="course-notice">Original academy lesson. Independent Japanese-language and assessment reviews pending; not official JLPT material.</div>
<div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map(o=><li>{o}</li>)}</ul></div>
<article class="lesson-article foundation-article"><Content /></article>
<OngoingGrammarPractice client:load />
<div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and recognition attempts are separate browser-local records. Free writing is ungraded.</p><LessonActions client:load lessonId="n5-m06-c04-l03" level="n5"/></div>
<div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div>
</div><aside class="lesson-side foundation-side"><h3>Grammar reminder</h3><p lang="ja">今、何をしていますか。 → 本を読んでいます。</p><p>Use で for an action location; 〜ています has uses beyond ongoing actions.</p></aside></div></section>
</Base>
