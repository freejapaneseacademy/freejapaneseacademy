---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Checkpoint from '../../../../../components/interactive/OngoingChapterCheckpoint';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/ongoing-activities-chapter-checkpoint');
if (!lesson) throw new Error('Missing n5-m06-c04-chk');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Ongoing activities',href:'/learn/n5/module-06/chapter-04/checkpoint/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 06 · CHAPTER 04 · CHECKPOINT</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Written chapter checkpoint</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original FreeJapaneseAcademy educational material. Independent Japanese and assessment reviews pending; not official JLPT material.</div><div class="lesson-intro"><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Checkpoint client:load /><div class="foundation-completion"><h2>Finish this checkpoint</h2><p>Completion is separate from the written recognition score.</p><LessonActions client:load lessonId="n5-m06-c04-chk" level="n5" /></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>〜ています · 何をしていますか · action locations · photo captions</p><p>Written checkpoint only. Chapter L06 contains the separate listening task.</p></aside></div></section>
</Base>
