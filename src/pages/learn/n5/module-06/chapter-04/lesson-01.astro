---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import OngoingContextPractice from '../../../../../components/interactive/OngoingContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/ongoing-activities-context');
if(!lesson || lesson.data.lessonId !== 'n5-m06-c04-l01') throw new Error('Missing canonical lesson n5-m06-c04-l01');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Ongoing activities',href:'/learn/n5/module-06/chapter-04/lesson-01/'}]}>
  <section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 06 · CHAPTER 04 · LESSON 01</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Context and meaning</span><span>12 recognition questions</span></div></div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice">Original academy material. Independent Japanese-language and assessment reviews pending; not official JLPT material.</div>
    <div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map(o=><li>{o}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <OngoingContextPractice client:load />
    <div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and recognition attempts are stored separately on this device when browser storage is available. Free writing is ungraded.</p><LessonActions client:load lessonId="n5-m06-c04-l01" level="n5"/></div>
    <div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div>
  </div><aside class="lesson-side foundation-side"><h3>Ask what is happening now</h3><p>今、何をしていますか。 → 本を読んでいます。</p><p>Written context lesson; no recorded audio or pronunciation scoring.</p></aside></div></section>
</Base>
