---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import MeetingWordsPractice from '../../../../../components/interactive/MeetingWordsPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/meeting-words-vocabulary');
if(!lesson||lesson.data.lessonId!=='n5-m01-c01-l02')throw new Error('Missing canonical N5 vocabulary lesson');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={false} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 01 · CHAPTER 01 · LESSON 02</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original written vocabulary practice. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><MeetingWordsPractice client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="n5-m01-c01-l02" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-01/chapter-01/lesson-01/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>First read the profile labels, then compare country, nationality and occupation. Return tomorrow to retrieve the words without looking.</p></aside></div></section>
</Base>
