---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/N5IntroductionGrammarPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/introductions-identity-grammar');
if(!lesson||lesson.data.lessonId!=='n5-m01-c01-l03')throw new Error('Missing canonical N5 grammar lesson');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/'},{label:'Introducing people',href:'/learn/n5/module-01/chapter-01/lesson-03/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 01 · CHAPTER 01 · LESSON 03</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>12 written practice questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy practice; independent language and assessment review pending.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><Practice client:load/><div class="foundation-completion"><h2>Complete this lesson</h2><p>Completion and practice attempts are stored separately on this device.</p><LessonActions client:load lessonId="n5-m01-c01-l03" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/">Course overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Find the topic, choose the noun predicate, then decide whether the sentence states, asks or denies.</p></aside></div></section>
</Base>