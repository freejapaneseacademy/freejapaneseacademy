---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/FirstMeetingShadowing';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/first-meeting-shadowing');
if (!lesson || lesson.data.lessonId !== 'n5-m01-c01-l08') throw new Error('Missing canonical N5 first-meeting shadowing lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Meeting people',href:'/learn/n5/module-01/chapter-01/lesson-08/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 01 · CHAPTER 01 · OPTIONAL LESSON 08</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Optional speaking and shadowing</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy material. Independent Japanese, pronunciation and assessment reviews pending. Not official JLPT material. Speaking and recording are optional.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load/><div class="foundation-completion"><h2>Finish or skip this optional lesson</h2><p>Speaking is never a requirement for course progression. Written recognition attempts and lesson completion are separate browser-local records.</p><LessonActions client:load lessonId="n5-m01-c01-l08" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-01/chapter-01/lesson-07/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Shadowing method</h3><p>Listen, pause, repeat, switch roles. Use fictional personal details if you prefer.</p><p>Record only if you choose; no automatic speech grading or upload.</p></aside></div></section>
</Base>
