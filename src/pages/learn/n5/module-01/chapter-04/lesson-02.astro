---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Studio from '../../../../../components/interactive/PersonalProfileWordsPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/personal-profile-vocabulary');
if (!lesson || lesson.data.lessonId !== 'n5-m01-c04-l02') throw new Error('Missing canonical personal profile vocabulary lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Profile vocabulary',href:'/learn/n5/module-01/chapter-04/lesson-02/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 01 · CHAPTER 04 · LESSON 02</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Vocabulary and word study</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy material. Independent Japanese and assessment reviews pending. Not official JLPT material.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Studio client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and quiz attempts are saved on this device.</p><LessonActions client:load lessonId="n5-m01-c04-l02" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-01/chapter-04/lesson-01/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Review age, hometown and occupation vocabulary. Do not confuse place of origin with current residence.</p><p>Written practice only; listening belongs to L06.</p></aside></div></section>
</Base>
