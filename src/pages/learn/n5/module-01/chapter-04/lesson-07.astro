---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import OrientationSelfIntroductionWriting from '../../../../../components/interactive/OrientationSelfIntroductionWriting';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/orientation-self-introduction-writing');
if(!lesson) throw new Error('Missing N5-M01-C04-L07 content');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Writing',href:'/learn/n5/module-01/chapter-04/lesson-07/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 01 · CHAPTER 04 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Writing and typing</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
<div class="course-notice">Original fictional Japanese profiles. Independent Japanese and assessment reviews remain pending. Not official JLPT material.</div>
<div class="lesson-intro"><h2>Learning objectives</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
<article class="lesson-article foundation-article"><Content /></article>
<OrientationSelfIntroductionWriting client:load />
<div class="foundation-completion"><h2>Finish this lesson</h2><p>Mark completion separately after writing and self-review.</p><LessonActions client:load lessonId="n5-m01-c04-l07" level="n5" /></div>
</div><aside class="lesson-side foundation-side"><h3>Writing guide</h3><p>Use polite です, topic は, and の for noun relationships. Keep hometown distinct from current residence.</p><ol><li>Read models</li><li>Check written facts</li><li>Compose a new profile</li><li>Self-review and revise</li></ol></aside></div></section>
</Base>
