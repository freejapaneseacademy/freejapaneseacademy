---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/N5ProfileListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/personal-profiles-listening');
if (!lesson || lesson.data.lessonId !== 'n5-m01-c04-l06') throw new Error('Missing canonical profile listening lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Personal profiles',href:'/learn/n5/module-01/chapter-04/lesson-06/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 01 · CHAPTER 04 · LESSON 06</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Listening comprehension</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy dialogues. Independent Japanese, pronunciation and assessment reviews pending. Not official JLPT material.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and listening attempts are saved on this device.</p><LessonActions client:load lessonId="n5-m01-c04-l06" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-01/chapter-04/lesson-05/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Listening guide</h3><p>Listen for age, hometown and work or school role. Do not confuse where someone is from with where they live now.</p><p>Recorded WAV availability and rights verification are required before scoring can work.</p></aside></div></section>
</Base>
