---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/OrientationProfilesPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/orientation-profiles-context');
if (!lesson || lesson.data.lessonId !== 'n5-m01-c04-l01') throw new Error('Missing canonical orientation profile lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Personal profiles and review',href:'/learn/n5/module-01/chapter-04/lesson-01/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 01 · CHAPTER 04 · LESSON 01</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Context and meaning</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy material. Independent Japanese and assessment reviews pending. Not official JLPT material.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and written recognition attempts are saved separately on this device.</p><LessonActions client:load lessonId="n5-m01-c04-l01" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-01/chapter-03/checkpoint/">Previous checkpoint</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Find the exact phrase supporting each detail in the two fictional profile cards. Do not infer nationality or current residence.</p><p>No recorded audio is required for this written context lesson.</p></aside></div></section>
</Base>
