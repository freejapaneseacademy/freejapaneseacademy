---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/ClassroomInterviewShadowing';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/classroom-interview-shadowing');
if (!lesson || lesson.data.lessonId !== 'n5-m01-c02-l08') throw new Error('Missing canonical interview shadowing lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={false} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Questions about people',href:'/learn/n5/module-01/chapter-02/lesson-08/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 01 · CHAPTER 02 · LESSON 08</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Optional speaking</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy material. No automatic pronunciation evaluation. Independent Japanese, assessment and audio review pending.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and recognition scores are separate from optional speaking self-review.</p><LessonActions client:load lessonId="n5-m01-c02-l08" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Ask, pause, answer, and repair misunderstandings. Reuse L06 authentic audio only after media QA is verified.</p><p>Text-based rehearsal works without a microphone. The audio-based shadowing gate remains pending.</p></aside></div></section>
</Base>
