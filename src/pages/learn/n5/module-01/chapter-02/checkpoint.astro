---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import N5QuestionWordsCheckpoint from '../../../../../components/interactive/N5QuestionWordsCheckpoint';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/questions-about-people-checkpoint');
if(!lesson||lesson.data.lessonId!=='n5-m01-c02-chk')throw new Error('Missing canonical lesson n5-m01-c02-chk');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 01 · Chapter 02 · Checkpoint</span></nav><span class="eyebrow">N5 · MODULE 01 · CHAPTER 02 · CHECKPOINT</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>14 questions with verified audio; 10 written-only</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Draft checkpoint:</strong> Licensed predecessor audio and independent reviews await verification.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><N5QuestionWordsCheckpoint client:load/><div class="foundation-completion"><h2>Finish the checkpoint</h2><p>Progress and attempts are stored locally on this device.</p><LessonActions client:load lessonId="n5-m01-c02-chk" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Listen for the reply</h3><p>A question is not evidence of the answer. Find the stated name, place or item.</p></aside></div></section>
</Base>
