---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import FamilyChartReading from '../../../../../components/interactive/FamilyChartReading';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/family-chart-reading');
if(!lesson||lesson.data.lessonId!=='n5-m01-c03-l05')throw new Error('Missing canonical lesson n5-m01-c03-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/n5/">N5</a><span>›</span><span>Module 01 · Chapter 03 · Lesson 05</span></nav><span class="eyebrow">N5 · MODULE 01 · CHAPTER 03 · LESSON 05</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Original written reading</span><span>10 questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Written reading only. Independent Japanese-language and assessment review pending; not official JLPT material.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><FamilyChartReading client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Lesson completion and quiz attempts are separate local records.</p><LessonActions client:load lessonId="n5-m01-c03-l05" level="n5"/></div><div class="lesson-next"><h3>Continue</h3><a class="btn btn-outline" href="/learn/n5/">N5 course overview</a></div></div><aside class="lesson-side foundation-side"><h3>Reading strategy</h3><p>Track the person before の and the family word after it. Quote the line before deciding.</p><p>あね = older sister · あに = older brother · おとうと = younger brother</p></aside></div></section>
</Base>
