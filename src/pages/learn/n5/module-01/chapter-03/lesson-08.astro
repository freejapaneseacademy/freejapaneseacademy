---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Studio from '../../../../../components/interactive/FamilyShadowingStudio';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/family-introduction-shadowing');
if (!lesson || lesson.data.lessonId !== 'n5-m01-c03-l08') throw new Error('Missing canonical family shadowing lesson');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Family shadowing',href:'/learn/n5/module-01/chapter-03/lesson-08/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 01 · CHAPTER 03 · LESSON 08</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Optional speaking / shadowing</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy material. Independent Japanese and pronunciation review pending. Not official JLPT material.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Studio client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><p>Completion and written quiz attempts are saved on this device.</p><LessonActions client:load lessonId="n5-m01-c03-l08" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-01/chapter-03/lesson-07/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Switch roles, compare 兄 and お兄さん, and practise only with fictional family details.</p><p>Record only if you choose; no automatic pronunciation score.</p></aside></div></section>
</Base>
