---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Writing from '../../../../../components/interactive/HobbyIntroductionWriting';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/hobby-introduction-writing');
if (!lesson) throw new Error('Missing n5-m07-c01-l07');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Likes and strengths',href:'/learn/n5/module-07/chapter-01/lesson-07/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 07 · CHAPTER 01 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Writing and typing</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original FreeJapaneseAcademy teaching material. Independent Japanese-language and assessment reviews pending; not official JLPT material.</div><div class="lesson-intro"><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Writing client:load /><div class="foundation-completion"><h2>Finish this lesson</h2><p>Lesson completion and recognition scores are stored separately. Your creative writing is self-reviewed.</p><LessonActions client:load lessonId="n5-m07-c01-l07" level="n5" /></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Writing guide</h3><p>Write 2–5 connected sentences about likes, dislikes and abilities. Use the five-criterion rubric to revise.</p><p>No microphone or personal information is required.</p></aside></div></section>
</Base>
