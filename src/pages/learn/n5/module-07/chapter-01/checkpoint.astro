---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/LikesCheckpointPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/likes-strengths-checkpoint');
if(!lesson||lesson.data.lessonId!=='n5-m07-c01-chk')throw new Error('Missing canonical likes checkpoint');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Likes checkpoint',href:'/learn/n5/module-07/chapter-01/checkpoint/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 07 · CHAPTER 01 · CHECKPOINT</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Chapter checkpoint</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original fictional learning material. Independent Japanese and assessment reviews pending. Not official JLPT content.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><Practice client:load/><div class="foundation-completion"><h2>Finish this checkpoint</h2><p>Completion and formative attempts are stored separately on this device.</p><LessonActions client:load lessonId="n5-m07-c01-chk" level="n5"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/module-07/chapter-01/lesson-08/">Previous lesson</a><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study strategy</h3><p>Identify whether each sentence describes a preference, a skill or an ability. Cite Japanese evidence.</p></aside></div></section>
</Base>