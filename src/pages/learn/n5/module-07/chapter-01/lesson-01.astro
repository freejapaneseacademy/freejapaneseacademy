---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import LikesContextPractice from '../../../../../components/interactive/LikesContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','n5/likes-strengths-context');
if(!lesson || lesson.data.lessonId !== 'n5-m07-c01-l01') throw new Error('Missing canonical lesson n5-m07-c01-l01');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Likes and strengths',href:'/learn/n5/module-07/chapter-01/lesson-01/'}]}>
 <section class="page-hero"><div class="container"><p class="eyebrow">N5 · MODULE 07 · CHAPTER 01 · LESSON 01</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Context and meaning</span><span>12 recognition questions</span></div></div></section>
 <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
  <div class="course-notice">Original academy material. Independent Japanese-language and assessment reviews pending; not official JLPT material.</div>
  <div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map(o=><li>{o}</li>)}</ul></div>
  <article class="lesson-article foundation-article"><Content /></article>
  <LikesContextPractice client:load />
  <div class="foundation-completion"><h2>Finish the lesson</h2><p>Lesson completion and recognition attempts are stored separately on this device when browser storage is available. Free writing is ungraded.</p><LessonActions client:load lessonId="n5-m07-c01-l01" level="n5"/></div>
  <div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div>
 </div><aside class="lesson-side foundation-side"><h3>Likes versus abilities</h3><p lang="ja">音楽が好きです。ギターが少しできます。</p><p>Preference is not the same as ability. Written lesson; no audio or pronunciation score.</p></aside></div></section>
</Base>