---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/ComparingContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','n5/comparing-choices-context');
if(!lesson) throw new Error('Missing n5-m07-c03-l01');
const { Content }=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'N5',href:'/learn/n5/'},{label:'Comparing choices',href:'/learn/n5/module-07/chapter-03/lesson-01/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">N5 · MODULE 07 · CHAPTER 03 · LESSON 01</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Context and meaning</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original teaching material. Independent Japanese-language and assessment reviews pending; not official JLPT material.</div><div class="lesson-intro"><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load /><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and written quiz scores are stored separately in your browser.</p><LessonActions client:load lessonId="n5-m07-c03-l01" level="n5" /></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/n5/">N5 overview</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Compare price and start time separately. Find the phrase that supports the final choice.</p><p>This lesson is written; listening practice is taught separately in L06.</p></aside></div></section>
</Base>