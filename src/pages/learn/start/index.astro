---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { buildFoundationsCatalog } from '../../../lib/foundationsCatalog';
import inventory from '../../../../docs/LESSON_INVENTORY.json';
import '../../../styles/foundations.css';
import '../../../styles/foundations-catalog.css';

// Single source of truth: the published inventory + lesson frontmatter.
// Never manually append cards or sections after </Base>.
const entries = await getCollection('lessons');
const modules = buildFoundationsCatalog(inventory.items, entries.map(entry => entry.data));
const lessonTotal = modules.reduce((sum, module) => sum + module.total, 0);
const lastModule = modules[modules.length - 1];
const lastChapter = lastModule?.chapters[lastModule.chapters.length - 1];
---
<Base
  title="Japanese Foundations — Start Here"
  description="Study Japanese Foundations step by step. Browse published lessons in the correct module and chapter order, from writing systems to hiragana reading and speaking."
  breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Japanese Foundations',href:'/learn/start/'}]}
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">›</span><a href="/learn/">Courses</a>
        <span aria-hidden="true">›</span><span aria-current="page">Foundations</span>
      </nav>
      <span class="eyebrow">LEVEL 0 · JAPANESE FOUNDATIONS</span>
      <h1>Your path into Japanese.</h1>
      <p>Learn the building blocks in order. Each chapter combines guided explanations with reading, writing, listening, or speaking practice as appropriate.</p>
    </div>
  </section>

  <section class="page-body" aria-label="Published Foundations curriculum">
    <div class="container foundation-catalog" id="foundations-catalog">
      <div class="foundation-catalog-intro">
        <div>
          <span class="foundation-catalog-intro__eyebrow">Your study path</span>
          <h2>Find your next lesson</h2>
          <p>Lessons are arranged by module and chapter. Open a chapter to choose an activity, and complete its checkpoint before moving on.</p>
        </div>
        <div class="foundation-catalog-count" aria-label={lessonTotal + ' available lessons and checkpoints'}>
          <strong>{lessonTotal}</strong><span>available<br />activities</span>
        </div>
      </div>

      <nav class="foundation-catalog-nav" aria-label="Jump to a module">
        {modules.map(module => (
          <a href={'#' + module.id}>
            <span>Module {String(module.number).padStart(2,'0')}</span>
            <strong>{module.title}</strong>
          </a>
        ))}
      </nav>

      {modules.map(module => (
        <section id={module.id} class="foundation-catalog-module" aria-labelledby={module.id + '-heading'}>
          <header class="foundation-catalog-module__heading">
            <div>
              <span class="foundation-catalog-kicker">Module {String(module.number).padStart(2,'0')}</span>
              <h2 id={module.id + '-heading'}>{module.title}</h2>
            </div>
            <p>{module.chapters.length} chapters · {module.total} activities</p>
          </header>

          {module.chapters.map((chapter, chapterIndex) => (
            <details class="foundation-catalog-chapter" data-chapter-id={chapter.id}
              open={chapterIndex === 0 || (module.id === lastModule?.id && chapter.id === lastChapter?.id)}>
              <summary>
                <span class="foundation-catalog-chapter__number">Chapter {String(chapter.number).padStart(2,'0')}</span>
                <h3>{chapter.title}</h3>
                <span class="foundation-catalog-chapter__count">{chapter.lessons.length} activities</span>
                <span class="foundation-catalog-chapter__chevron" aria-hidden="true">⌄</span>
              </summary>
              <ol class="foundation-catalog-list">
                {chapter.lessons.map(lesson => (
                  <li data-foundation-lesson-id={lesson.id}>
                    <a class:list={['foundation-catalog-card', {'foundation-catalog-card--checkpoint':lesson.isCheckpoint}]}
                      href={lesson.href}>
                      <span class="foundation-catalog-card__step" aria-hidden="true">
                        {lesson.isCheckpoint ? '✓' : lesson.slot.slice(1)}
                      </span>
                      <span class="foundation-catalog-card__content">
                        <span class="foundation-catalog-card__meta">
                          {lesson.label} <span aria-hidden="true">·</span> {lesson.minutes} min
                        </span>
                        <span class="foundation-catalog-card__title">{lesson.title}</span>
                        <span class="foundation-catalog-card__description">{lesson.description}</span>
                      </span>
                      <span class="foundation-catalog-card__arrow" aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </section>
      ))}
      <p class="foundation-catalog-footer">More activities will appear here automatically once their lessons pass publication checks.</p>
    </div>
  </section>
</Base>
