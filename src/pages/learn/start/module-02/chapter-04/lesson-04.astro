---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaFluencyTypingPractice from '../../../../../components/interactive/HiraganaFluencyTypingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-fluency-typing');
if(!lesson||lesson.data.lessonId!=='l0-m02-c04-l04')throw new Error('Missing canonical lesson l0-m02-c04-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana I',href:'/learn/start/module-02/chapter-04/lesson-04/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 04 · Lesson 04</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 04 · LESSON 04</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Ten picture labels</span><span>Ten typed answers</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner lesson.</strong> Written recognition and typing only; independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaFluencyTypingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and typing attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m02-c04-l04" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 04 lesson 05 — word-card reading.</p><a class="btn btn-outline" href="/learn/start/module-02/chapter-04/lesson-03/">Previous lesson</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Hiragana I · Fluency</h3><p>Read ten familiar words, check complete kana shapes and type exact labels.</p></aside></div></section>
</Base>