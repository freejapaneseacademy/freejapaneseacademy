---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaSoundPractice from '../../../../../components/interactive/HiraganaSoundPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-vowels-ks-mapping');
if(!lesson||lesson.data.lessonId!=='l0-m02-c01-l03')throw new Error('Missing canonical lesson l0-m02-c01-l03');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana I',href:'/learn/start/module-02/chapter-01/lesson-03/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 01 · Lesson 03</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 01 · LESSON 03</span><h1>Hiragana sounds and strokes</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>15 kana</span><span>8 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner lesson.</strong> Written character-to-sound practice only. Independent Japanese and assessment reviews pending; no audio, speaking or stroke-order score.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaSoundPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m02-c01-l03" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: Lesson 04 — kana recognition, typing and optional tracing.</p><a class="btn btn-outline" href="/learn/start/module-02/chapter-01/lesson-02/">Previous lesson</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Hiragana I</h3><p>Map fifteen kana to sounds, decode familiar words, and distinguish recognition from stroke-order instruction.</p><p>Audio and writing assessment are separate later lessons.</p></aside></div></section>
</Base>