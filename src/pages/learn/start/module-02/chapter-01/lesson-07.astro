---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaWritingStudio from '../../../../../components/interactive/HiraganaWritingStudio';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/hiragana-vowels-ks-writing');
if (!lesson || lesson.data.lessonId !== 'l0-m02-c01-l07') throw new Error('Missing canonical lesson l0-m02-c01-l07');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana writing',href:'/learn/start/module-02/chapter-01/lesson-07/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 01 · Lesson 07</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 01 · LESSON 07</span><h1>Write the fifteen hiragana</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>20 scored kana prompts</span><span>2 self-reviewed writing tasks</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original academy writing lesson.</strong> Exact short-answer scoring only; handwriting and open writing are self-reviewed. Independent qualified Japanese and assessment review pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaWritingStudio client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and the constrained written score are separate local progress records.</p><LessonActions client:load lessonId="l0-m02-c01-l07" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-01/lesson-06/">Previous: listening practice</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Write, compare, revise</h3><p>Use a Japanese IME, build familiar words, and compare your optional handwriting against printed models.</p><p>No automatic penmanship or stroke-order grade is offered.</p></aside></div></section>
</Base>
