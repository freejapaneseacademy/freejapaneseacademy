---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ReusableListeningPractice from '../../../../../components/interactive/ReusableListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import manifest from '../../../../../content/audio/l0-m02-c01-l06-v1.json';
import exercise from '../../../../../content/exercises/l0-m02-c01-l06.json';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/hiragana-vowels-ks-listening');
if (!lesson || lesson.data.lessonId !== 'l0-m02-c01-l06') throw new Error('Missing canonical lesson l0-m02-c01-l06');
const { Content } = await render(lesson);
const tracks = manifest.assets.map((asset, i) => ({
  id: (i === 0 ? 'a' : 'b') as 'a' | 'b',
  assetId: asset.id,
  label: `Conversation ${i === 0 ? 'A' : 'B'}`,
  url: asset.mediaPath,
  durationSeconds: asset.durationSeconds,
  transcript: asset.transcript,
  english: asset.english
}));
const questions = exercise.items.map(item => ({
  id: item.id,
  trackId: item.trackId,
  prompt: item.prompt,
  choices: item.choices,
  answerKey: item.answerKey,
  explanation: item.explanation,
  evidence: item.evidence
}));
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana listening',href:'/learn/start/module-02/chapter-01/lesson-06/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 01 · Lesson 06</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 01 · LESSON 06</span><h1>Hear Japanese in everyday conversations</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>2 original WAV dialogues</span><span>6 listening questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original academy Japanese listening.</strong> Licensed synthetic AivisSpeech voices. Independent qualified pronunciation and assessment review pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><ReusableListeningPractice client:load lessonId="l0-m02-c01-l06" level="l0" version={1} tracks={tracks} questions={questions}/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and unaided listening attempts are stored separately in your browser.</p><LessonActions client:load lessonId="l0-m02-c01-l06" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-01/lesson-05/">Previous: reading practice</a><a class="btn btn-outline" href="/learn/start/module-02/chapter-01/lesson-07/">Next: writing practice</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Listen before you read</h3><p>Listen for the key objects, the speakers’ responses, and the details they mention.</p><p>Reveal the transcript after your first attempt to compare what you heard.</p></aside></div></section>
</Base>
