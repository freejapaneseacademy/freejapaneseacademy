---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaGridReading from '../../../../../components/interactive/HiraganaGridReading';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/hiragana-vowels-ks-reading');
if (!lesson || lesson.data.lessonId !== 'l0-m02-c01-l05') throw new Error('Missing canonical lesson l0-m02-c01-l05');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana I',href:'/learn/start/module-02/chapter-01/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 01 · Lesson 05</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 01 · LESSON 05</span><h1>Read the kana-card grid</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>15 kana</span><span>8 reading questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner reading.</strong> Written grid and card evidence only. Independent Japanese-language and assessment reviews pending; no listening or handwriting grade.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaGridReading client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are saved separately on this device.</p><LessonActions client:load lessonId="l0-m02-c01-l05" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: Lesson 06 — hear actual recorded Japanese syllables.</p><a class="btn btn-outline" href="/learn/start/module-02/chapter-01/lesson-04/">Previous lesson</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Hiragana I</h3><p>Locate a printed kana by its row and column, then cite the exact card or grid cell.</p><p>The chart is written evidence, not a sound recording or stroke-order guide.</p></aside></div></section>
</Base>
