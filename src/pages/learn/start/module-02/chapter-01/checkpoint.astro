---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaCheckpointWritten from '../../../../../components/learning/HiraganaCheckpointWritten';
import HiraganaCheckpointListening from '../../../../../components/learning/HiraganaCheckpointListening';
import LessonActions from '../../../../../components/interactive/LessonActions';
import written from '../../../../../content/exercises/l0-m02-c01-chk-written-v1.json';
import listening from '../../../../../content/exercises/l0-m02-c01-chk-listening-v1.json';
import audio from '../../../../../content/audio/l0-m02-c01-l06-v1.json';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/hiragana-vowels-ks-checkpoint');
if (!lesson || lesson.data.lessonId !== 'l0-m02-c01-chk' || lesson.data.publicationStatus !== 'published' ||
  written.items.length !== 12 || listening.items.length !== 4 || listening.lessonId !== lesson.data.lessonId ||
  audio.assets.length !== 2 || listening.items.some(item => !audio.assets.some(asset => asset.id === item.stimulusId)) ||
  audio.assets.some(asset => !asset.rights.redistributionCleared || !asset.qa.sha256 || asset.turns.length !== 4)) {
  throw new Error('Incomplete canonical L0-M02-C01 checkpoint');
}
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana checkpoint',href:'/learn/start/module-02/chapter-01/checkpoint/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Hiragana chapter checkpoint</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 01 · CHECKPOINT</span><h1>Can you read the first fifteen hiragana?</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>12 written checks</span><span>4 real audio checks</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original mixed checkpoint.</strong> Written and listening scores are stored separately. Genuine licensed L06 recordings; qualified independent reviews pending.</div><div class="lesson-intro"><span class="eyebrow">CHECKPOINT GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o: string) => <li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaCheckpointWritten client:load/><div class="sample-rule"></div><HiraganaCheckpointListening client:load/><div class="foundation-completion"><h2>Finish this chapter</h2><p>Review your errors, plan another practice session and mark the checkpoint complete. Completion does not certify mastery.</p><LessonActions client:load lessonId="l0-m02-c01-chk" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-01/lesson-08/">Previous: optional speaking</a><a class="btn btn-primary" href="/learn/start/">All Foundations lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Vowels, K and S</h3><p>Match fifteen kana, read three cards, then listen to two unchanged original conversations.</p><p>Record weak items for later practice; this is a local formative check, not a proficiency certificate.</p></aside></div></section>
</Base>