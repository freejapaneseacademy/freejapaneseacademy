---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import TNHCheckpointWritten from '../../../../../components/learning/TNHCheckpointWritten';
import TNHCheckpointListening from '../../../../../components/learning/TNHCheckpointListening';
import LessonActions from '../../../../../components/interactive/LessonActions';
import written from '../../../../../content/exercises/l0-m02-c02-chk-written-v1.json';
import listening from '../../../../../content/exercises/l0-m02-c02-chk-listening-v1.json';
import audio from '../../../../../content/audio/l0-m02-c02-l06-v1.json';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/hiragana-tnh-checkpoint');
if (!lesson || lesson.data.lessonId !== 'l0-m02-c02-chk' || lesson.data.publicationStatus !== 'published' ||
  written.items.length !== 12 || listening.items.length !== 4 || listening.lessonId !== lesson.data.lessonId ||
  audio.assets.length !== 2 || listening.items.some(item => !audio.assets.some(asset => asset.id === item.stimulusId)) ||
  audio.assets.some(asset => !asset.rights.redistributionCleared || !asset.qa.sha256 || asset.turns.length !== 4)) throw new Error('Incomplete T/N/H checkpoint');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'T/N/H checkpoint',href:'/learn/start/module-02/chapter-02/checkpoint/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>T/N/H checkpoint</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 02 · CHECKPOINT</span><h1>Can you read T/N/H hiragana?</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>12 written checks</span><span>4 real audio checks</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original mixed checkpoint.</strong> Written and listening scores are separate. Original licensed audio; independent reviews pending.</div><div class="lesson-intro"><span class="eyebrow">CHECKPOINT GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o: string) => <li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><TNHCheckpointWritten client:load/><div class="sample-rule"></div><TNHCheckpointListening client:load/><div class="foundation-completion"><h2>Finish this chapter</h2><p>Review errors and mark complete; completion is not certification.</p><LessonActions client:load lessonId="l0-m02-c02-chk" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-02/lesson-08/">Previous: optional speaking</a><a class="btn btn-primary" href="/learn/start/">All Foundations lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>T, N and H rows</h3><p>Review fifteen kana, four printed labels and two licensed conversations. Review weak items on later days.</p></aside></div></section>
</Base>