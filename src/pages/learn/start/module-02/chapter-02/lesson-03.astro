---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaTNHSoundPractice from '../../../../../components/interactive/HiraganaTNHSoundPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-tnh-sound-exceptions');
if(!lesson||lesson.data.lessonId!=='l0-m02-c02-l03')throw new Error('Missing canonical lesson l0-m02-c02-l03');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana I',href:'/learn/start/module-02/chapter-02/lesson-03/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 02 · Lesson 03</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 02 · LESSON 03</span><h1>Read T/N/H kana accurately</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>15 kana</span><span>8 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner lesson.</strong> Written reading cues and recognition only; no audio or pronunciation grade. Independent qualified reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaTNHSoundPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m02-c02-l03" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: Lesson 04 — T/N/H kana typing and tracing.</p><a class="btn btn-outline" href="/learn/start/module-02/chapter-02/lesson-02/">Previous lesson</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Hiragana I · T/N/H</h3><p>Compare printed kana, check the eight answers and save your completion locally.</p><p>Actual listening and handwriting practice come later.</p></aside></div></section>
</Base>