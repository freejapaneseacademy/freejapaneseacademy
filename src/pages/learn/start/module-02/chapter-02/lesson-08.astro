---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import TNHShadowing from '../../../../../components/interactive/TNHShadowing';
import LessonActions from '../../../../../components/interactive/LessonActions';
import audio from '../../../../../content/audio/l0-m02-c02-l06-v1.json';
import '../../../../../styles/foundations.css';
import '../../../../../styles/vowel-speaking.css';
const lesson = await getEntry('lessons', 'l0/hiragana-tnh-speaking');
if (!lesson || lesson.data.lessonId !== 'l0-m02-c02-l08' ||
  audio.lessonId !== 'l0-m02-c02-l06' || audio.assets.length !== 2 ||
  audio.assets.some(asset => !asset.rights.redistributionCleared || !asset.qa.sha256 || asset.turns.length !== 4)) {
  throw new Error('L08 speaking lesson and licensed L06 model package mismatch');
}
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'T/N/H speaking',href:'/learn/start/module-02/chapter-02/lesson-08/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 02 · Lesson 08</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 02 · LESSON 08</span><h1>Shadow T/N/H words in everyday conversations</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>2 licensed model recordings</span><span>6 optional knowledge questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Optional speaking; no automatic pronunciation grade.</strong> Unchanged AivisSpeech WAVs from L06. Independent qualified reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o: string) => <li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><TNHShadowing client:load tracks={audio.assets}/><div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Completion does not require a microphone or the optional knowledge check.</p><LessonActions client:load lessonId="l0-m02-c02-l08" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-02/lesson-07/">Previous: writing practice</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Listen, shadow, self-review</h3><p>Replay the model, rehearse each turn, and check your own progress without an accent score.</p></aside></div></section>
</Base>