---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaTNHVocabularyPractice from '../../../../../components/interactive/HiraganaTNHVocabularyPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-tnh-vocabulary');
if(!lesson||lesson.data.lessonId!=='l0-m02-c02-l02')throw new Error('Missing canonical lesson l0-m02-c02-l02');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana I',href:'/learn/start/module-02/chapter-02/lesson-02/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 02 · Lesson 02</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 02 · LESSON 02</span><h1>T/N/H hiragana in useful words</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>11 word cards</span><span>10 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner lesson.</strong> Written vocabulary only; no audio, handwriting or pronunciation grade. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaTNHVocabularyPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m02-c02-l02" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: Lesson 03 — sound exceptions and easily confused T/N/H kana.</p><a class="btn btn-outline" href="/learn/start/module-02/chapter-02/lesson-01/">Previous lesson</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Hiragana I · T/N/H</h3><p>Read eleven word cards, use their picture contexts, check ten questions and mark completion.</p><p>Sound exceptions and genuine listening practice follow in later lessons.</p></aside></div></section>
</Base>
