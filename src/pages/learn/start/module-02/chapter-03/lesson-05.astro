---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaMYRWReadingCheck from '../../../../../components/interactive/HiraganaMYRWReadingCheck';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-myrw-reading');
if(!lesson||lesson.data.lessonId!=='l0-m02-c03-l05')throw new Error('Missing canonical lesson l0-m02-c03-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'M/Y/R/W reading',href:'/learn/start/module-02/chapter-03/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 03 · Lesson 05</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 03 · LESSON 05</span><h1>Read the picture labels — M/Y/R/W hiragana</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>12 evidence-based reading questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original printed reading.</strong> No audio is needed or claimed. Independent qualified Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaMYRWReadingCheck client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m02-c03-l05" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-03/lesson-04/">Previous: kana typing</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Find printed evidence</h3><p>Read the exact kana on each picture card. Use the text, not guesses about a picture, to justify your answers.</p></aside></div></section>
</Base>
