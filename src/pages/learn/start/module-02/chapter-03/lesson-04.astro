---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaMYRWScriptStudio from '../../../../../components/interactive/HiraganaMYRWScriptStudio';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-myrw-script');
if(!lesson||lesson.data.lessonId!=='l0-m02-c03-l04')throw new Error('Missing canonical lesson l0-m02-c03-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'M/Y/R/W typing',href:'/learn/start/module-02/chapter-03/lesson-04/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 03 · Lesson 04</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 03 · LESSON 04</span><h1>Recognize and type M/Y/R/W hiragana</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>22 written questions</span><span>2 optional drafts</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original script lesson.</strong> Exact kana scoring; optional handwriting and drafts are self-reviewed. Independent qualified reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaMYRWScriptStudio client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and numeric quiz attempts are separate browser-local records.</p><LessonActions client:load lessonId="l0-m02-c03-l04" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-03/lesson-03/">Previous: ん and を</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Read, type, compare</h3><p>Use a Japanese IME or kana keyboard. Paper tracing is optional and self-reviewed.</p></aside></div></section>
</Base>