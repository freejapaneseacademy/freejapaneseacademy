---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaMYRWContextPractice from '../../../../../components/interactive/HiraganaMYRWContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-myrw-context');
if(!lesson||lesson.data.lessonId!=='l0-m02-c03-l01')throw new Error('Missing canonical lesson l0-m02-c03-l01');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana I',href:'/learn/start/module-02/chapter-03/lesson-01/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 03 · Lesson 01</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 03 · LESSON 01</span><h1>Hiragana M/Y/R/W rows — the final basic kana cards</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>16 kana cards</span><span>8 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner lesson.</strong> Written recognition only; no audio or pronunciation grade. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaMYRWContextPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m02-c03-l01" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 03 lesson 02 — everyday words with M/Y/R/W kana.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Hiragana I · M/Y/R/W</h3><p>Read the classroom board, compare the sixteen cards, check eight answers, then mark completion.</p><p>Audio and writing practice follow in later lessons.</p></aside></div></section>
</Base>
