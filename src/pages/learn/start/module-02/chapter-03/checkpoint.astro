---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import MYRWCheckpoint from '../../../../../components/interactive/MYRWCheckpoint';
import LessonActions from '../../../../../components/interactive/LessonActions';
import manifest from '../../../../../content/audio/l0-m02-c03-l06-v1.json';
import bank from '../../../../../content/exercises/l0-m02-c03-chk.json';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/hiragana-myrw-checkpoint');
if (!lesson || lesson.data.lessonId !== 'l0-m02-c03-chk' || bank.lessonId !== lesson.data.lessonId || bank.items.length !== 12 || manifest.assets.length !== 2 || manifest.assets.some(a => !a.rights.redistributionCleared || !a.qa.sha256)) throw new Error('Chapter 03 checkpoint package invalid');
const { Content } = await render(lesson);
const tracks = manifest.assets.map((a,i) => ({id:a.id,label:i ? 'Classroom dialogue' : 'Fruit shop dialogue',url:a.mediaPath,transcript:a.transcript,english:a.english}));
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Chapter 03 checkpoint',href:'/learn/start/module-02/chapter-03/checkpoint/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 03 · Checkpoint</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 03 · CHECKPOINT</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>12 scored items</span><span>2 licensed WAV dialogues</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original chapter checkpoint.</strong> Listening uses existing licensed recordings. Independent Japanese and assessment reviews remain pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string) => <li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><MYRWCheckpoint client:load questions={bank.items} tracks={tracks}/><div class="foundation-completion"><h2>Finish the chapter checkpoint</h2><p>Completion is separate from the numeric score. Optional speaking L08 is not required.</p><LessonActions client:load lessonId="l0-m02-c03-chk" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-03/lesson-07/">Previous: writing</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Check, explain, retry</h3><p>For mistakes, read the rationale and revisit the linked lesson. Listening scores distinguish unaided attempts from transcript-assisted review.</p></aside></div></section>
</Base>
