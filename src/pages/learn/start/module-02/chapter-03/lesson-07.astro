---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import MYRWWritingPractice from '../../../../../components/interactive/MYRWWritingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import bank from '../../../../../content/exercises/l0-m02-c03-l07.json';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/hiragana-myrw-writing');
if (!lesson || lesson.data.lessonId !== 'l0-m02-c03-l07' || bank.lessonId !== lesson.data.lessonId || bank.items.length !== 15) throw new Error('Missing L07 writing package');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'M/Y/R/W writing',href:'/learn/start/module-02/chapter-03/lesson-07/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 02 · Chapter 03 · Lesson 07</span></nav><span class="eyebrow">LEVEL 0 · MODULE 02 · CHAPTER 03 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>15 scored kana entries</span><span>Self-reviewed composition</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original writing practice.</strong> Exact kana typing is scored; free composition is learner self-reviewed. Independent qualified Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><MYRWWritingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from the constrained typing score and does not certify handwriting or pronunciation.</p><LessonActions client:load lessonId="l0-m02-c03-l07" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-02/chapter-03/lesson-06/">Previous: listening</a><a class="btn btn-outline" href="/learn/start/module-02/chapter-03/lesson-08/">Next: optional speaking</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Write, compare, revise</h3><p>Use the kana chart, then practise without looking. Check the particle を and the mora ん carefully.</p></aside></div></section>
</Base>