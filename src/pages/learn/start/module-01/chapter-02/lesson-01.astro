---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SoundContextPractice from '../../../../../components/interactive/SoundContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons', 'l0/japanese-sound-system-context');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c02-l01') throw new Error('Missing canonical lesson l0-m01-c02-l01');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Japanese sound system',href:'/learn/start/module-01/chapter-02/lesson-01/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 02 · Lesson 01</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 02 · LESSON 01</span>
    <h1>Five Japanese vowels.<br/>One new rhythm.</h1>
    <p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Chapter 01 introduction recommended</span><span>10 written practice questions</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original academy lesson.</strong> This is a written orientation to Japanese vowel qualities and mora timing, not a certified pronunciation or listening assessment. Independent Japanese and assessment-editor reviews remain pending.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <SoundContextPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>When you have read the examples and tried the written check, you may mark the lesson complete. Completion and quiz performance are saved separately; neither is a verified pronunciation score.</p><LessonActions client:load lessonId="l0-m01-c02-l01" level="l0" /></div>
    <div class="lesson-next"><h3>Continue learning</h3><p>Next in blueprint order: L0-M01-C02-L02 — Vocabulary and word study. It has not been published yet.</p><a class="btn btn-outline" href="/learn/start/module-01/chapter-01/checkpoint/">← Review Chapter 01</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a><a class="btn btn-outline" href="/dashboard/">My learning ↗</a></div>
  </div><aside class="lesson-side foundation-side">
    <span class="eyebrow">YOUR STUDY GUIDE</span><h3>Japanese sound system</h3><p><strong>L0-M01-C02-L01</strong></p><p>Emi and Ren's fictional classroom scene introduces the five vowel cards and the idea of mora timing.</p>
    <div class="sample-rule"></div><h3>Suggested order</h3><ol><li>Read the classroom exchange.</li><li>Compare the five vowel descriptions.</li><li>Count morae in the written examples.</li><li>Try the ten written questions.</li><li>Explain the rhythm in your own words.</li></ol><p>Audio discrimination belongs to later Chapter 02 lessons. No audio or microphone is presented or requested here.</p>
  </aside></div></section>
</Base>
