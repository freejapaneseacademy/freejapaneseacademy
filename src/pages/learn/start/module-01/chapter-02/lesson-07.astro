---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SoundWritingPractice from '../../../../../components/interactive/SoundWritingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import bank from '../../../../../content/exercises/l0-m01-c02-l07.json';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons', 'l0/japanese-sound-system-writing');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c02-l07' || bank.lessonId !== lesson.data.lessonId || bank.items.length !== 10) {
  throw new Error('Missing or mismatched canonical L0-M01-C02-L07 writing package');
}
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Japanese sound system',href:'/learn/start/module-01/chapter-02/lesson-07/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 02 · Lesson 07</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 02 · LESSON 07</span>
    <h1>Write Japanese vowel contrasts accurately.</h1>
    <p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Chapter 02 lessons 01–06 recommended</span><span>Ten kana entries · Four guided situations · Self-reviewed composition</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original academy writing practice.</strong> The scored tasks assess exact written forms, not listening or pronunciation. Free composition receives learner self-review, not a teacher grade. Automated content screening is not independent Japanese or assessment-editor review; those remain pending. This is not official JLPT material.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR WRITING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective: string) => <li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <SoundWritingPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is your own choice, separate from the ten-item aggregate typing score. Neither certifies spoken pronunciation, handwriting quality or mastery.</p><LessonActions client:load lessonId="l0-m01-c02-l07" level="l0" /></div>
    <div class="lesson-next"><h3>Continue Japanese Foundations</h3><p>Next in Blueprint order: published L0-M01-C02-L08 — optional speaking and shadowing with real model audio and private self-review.</p><a class="btn btn-outline" href="/learn/start/module-01/chapter-02/lesson-06/">← Review the real listening lesson</a><a class="btn btn-primary" href="/learn/start/module-01/chapter-02/lesson-08/">Continue to optional speaking lesson 08 →</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a><a class="btn btn-outline" href="/dashboard/">My learning ↗</a></div>
  </div><aside class="lesson-side foundation-side">
    <span class="eyebrow">STUDY GUIDE</span><h3>Japanese sound system</h3><p><strong>L0-M01-C02-L07</strong></p>
    <p>Produce five vowel kana, distinguish short and long written vowels, and build two polite classroom responses.</p><div class="sample-rule"></div>
    <h3>Suggested order</h3><ol><li>Review the five vowel forms.</li><li>Compare the two meaningful vowel-length pairs.</li><li>Type ten constrained answers.</li><li>Match four written replies to situations.</li><li>Write two Japanese lines and an English explanation.</li><li>Reveal the model, self-review and revise.</li></ol>
    <p>No microphone, new recording, new library or learner-data migration is needed.</p>
  </aside></div></section>
</Base>
