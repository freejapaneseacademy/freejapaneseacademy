---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SoundReadingPractice from '../../../../../components/interactive/SoundReadingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons','l0/japanese-sound-system-reading');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c02-l05') throw new Error('Missing canonical lesson l0-m01-c02-l05');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Japanese sound system',href:'/learn/start/module-01/chapter-02/lesson-05/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 02 · Lesson 05</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 02 · LESSON 05</span>
    <h1>Read a Japanese pronunciation map.</h1><p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Chapter 02 lessons 01–04 recommended</span><span>11-row original map · 12 evidence questions · optional writing</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original academy reading practice.</strong> This written map is not an audio discrimination test or an official JLPT item. Automated language screening does not constitute independent qualified Japanese-language or assessment review; both remain pending.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <SoundReadingPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Read the map and practise citing precise evidence. Your saved quiz result and completed-lesson marker are separate; neither certifies pronunciation or mastery.</p><LessonActions client:load lessonId="l0-m01-c02-l05" level="l0" /></div>
    <div class="lesson-next"><h3>Continue learning</h3><p>Next in blueprint order: L0-M01-C02-L06 — real minimal-pair listening. It is not yet published; real licensed and validated audio is required.</p><a class="btn btn-outline" href="/learn/start/module-01/chapter-02/lesson-04/">← Review kana forms</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a><a class="btn btn-outline" href="/dashboard/">My learning ↗</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">YOUR STUDY GUIDE</span><h3>Japanese sound system</h3><p><strong>L0-M01-C02-L05</strong></p><p>Read an original pronunciation map, identify stated details and cite exact row evidence.</p><div class="sample-rule"></div><h3>Suggested order</h3><ol><li>Review the five written vowel pairs.</li><li>Compare the k-row and picture labels.</li><li>Find long-vowel and mora notes.</li><li>Read the complete eleven-row map.</li><li>Answer twelve evidence questions.</li><li>Write and self-review an optional evidence note.</li></ol><p>No audio, new kanji target, or automatic writing grade is included.</p></aside></div></section>
</Base>
