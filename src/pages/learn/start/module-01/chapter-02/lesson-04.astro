---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SoundScriptPractice from '../../../../../components/interactive/SoundScriptPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons','l0/japanese-sound-system-script-practice');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c02-l04') throw new Error('Missing canonical lesson l0-m01-c02-l04');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Japanese sound system',href:'/learn/start/module-01/chapter-02/lesson-04/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 02 · Lesson 04</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 02 · LESSON 04</span>
    <h1>Recognize and type Japanese sound symbols.</h1><p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Chapter 02 lessons 01–03 recommended</span><span>8 kana cards · 12 written checks · optional tracing</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original academy lesson.</strong> This is visual recognition and writing practice, not a claim of verified hearing, speaking or stroke order. Independent qualified Japanese-language and assessment reviews are pending.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <SoundScriptPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Review the kana, enter the written answers, and optionally copy a character. A saved score and a completed-lesson marker are separate; neither certifies pronunciation or mastery.</p><LessonActions client:load lessonId="l0-m01-c02-l04" level="l0" /></div>
    <div class="lesson-next"><h3>Continue learning</h3><p>Next in blueprint order: L0-M01-C02-L05 — read an original pronunciation map and cite written evidence. Available now.</p><a class="btn btn-primary" href="/learn/start/module-01/chapter-02/lesson-05/">Study lesson 05 ↗</a><a class="btn btn-outline" href="/learn/start/module-01/chapter-02/lesson-03/">← Review vowel length</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a><a class="btn btn-outline" href="/dashboard/">My learning ↗</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">YOUR STUDY GUIDE</span><h3>Japanese sound system</h3><p><strong>L0-M01-C02-L04</strong></p><p>Visual kana forms, familiar word labels and accurate written mora counts.</p><div class="sample-rule"></div><h3>Suggested order</h3><ol><li>Review vowel pairs and k-row shapes.</li><li>Identify さ・す・し in familiar words.</li><li>Preserve extra vowel kana in long forms.</li><li>Try eight reveal cards and optional copying.</li><li>Complete twelve written questions.</li><li>Compare your optional explanation with the model.</li></ol><p>No new kanji target, recording or pronunciation grade is claimed in this lesson.</p></aside></div></section>
</Base>
