---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import StudyToolsContextPractice from '../../../../../components/interactive/StudyToolsContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','l0/study-tools-input-context');
if(!lesson || lesson.data.lessonId!=='l0-m01-c04-l01')throw new Error('Missing canonical lesson l0-m01-c04-l01');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Study tools and input methods',href:'/learn/start/module-01/chapter-04/lesson-01/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 04 · Lesson 01</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 04 · LESSON 01</span>
    <h1>Type Japanese.<br/>Read with support.</h1><p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Chapter 03 checkpoint recommended</span><span>12 written context questions</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original written lesson.</strong> Study an original fictional keyboard-help scene. This page does not test listening or pronunciation. Independent Japanese and assessment reviews remain pending.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content/></article>
    <StudyToolsContextPractice client:load/>
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Mark completion separately from your written quiz score. No microphone or synthetic pronunciation grade is used.</p><LessonActions client:load lessonId="l0-m01-c04-l01" level="l0"/></div>
    <div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 04 lesson 02, study vocabulary.</p><a class="btn btn-outline" href="/learn/start/module-01/chapter-03/checkpoint/">← Review Chapter 03 checkpoint</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Study tools and input methods</h3><p>First read Aya and Ken's keyboard-help exchange, then compare Japanese input and furigana. Check twelve written answers and explain the difference.</p><p>Actual blind listening belongs to a later audio-based lesson.</p></aside></div></section>
</Base>
