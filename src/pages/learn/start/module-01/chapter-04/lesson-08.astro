---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import StudyToolsSpeakingPractice from '../../../../../components/interactive/StudyToolsSpeakingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import audio from '../../../../../content/audio/l0-m01-c04-l06-v1.json';
import bank from '../../../../../content/exercises/l0-m01-c04-l08.json';
import '../../../../../styles/foundations.css';
import '../../../../../styles/vowel-speaking.css';
const lesson = await getEntry('lessons', 'l0/study-tools-input-speaking');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c04-l08' || bank.lessonId !== lesson.data.lessonId ||
    bank.items.length !== 5 || audio.lessonId !== 'l0-m01-c04-l06' || audio.assets.length !== 2 ||
    audio.assets.some(asset => !bank.modelAssetIds.includes(asset.id) || !asset.rights.redistributionCleared ||
      !asset.qa.sha256 || asset.turns.length < 2)) throw new Error('Chapter 04 L08 speaking models and lesson mismatch');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Study tools and input methods',href:'/learn/start/module-01/chapter-04/lesson-08/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 04 · Lesson 08</span></nav><span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 04 · OPTIONAL LESSON 08</span><h1>Speak Japanese classroom requests</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Two licensed WAV models</span><span>Optional private microphone</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Optional speaking, no automatic pronunciation grading.</strong> Reused original Chapter 04 L06 AivisSpeech WAVs; independent Japanese pronunciation and assessment reviews pending. No microphone required.</div><div class="lesson-intro"><span class="eyebrow">YOUR SPEAKING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><StudyToolsSpeakingPractice client:load tracks={audio.assets} bank={bank} /><div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Shadow and self-review at your pace. Completion does not certify pronunciation or require a microphone or knowledge quiz.</p><LessonActions client:load lessonId="l0-m01-c04-l08" level="l0" /></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-01/chapter-04/lesson-07/">← Review writing L07</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Study tools and input methods</h3><p><strong>L0-M01-C04-L08</strong></p><ol><li>Read the classroom models.</li><li>Play each recorded dialogue.</li><li>Shadow real turns.</li><li>Optionally record privately.</li><li>Self-review without a machine speaking grade.</li><li>Optionally answer five knowledge questions.</li></ol><p>No private audio is uploaded.</p></aside></div></section>
</Base>