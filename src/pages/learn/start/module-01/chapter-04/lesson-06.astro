---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ReusableListeningPractice from '../../../../../components/interactive/ReusableListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import audio from '../../../../../content/audio/l0-m01-c04-l06-v1.json';
import bank from '../../../../../content/exercises/l0-m01-c04-l06.json';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons', 'l0/study-tools-input-listening');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c04-l06') throw new Error('Missing canonical Chapter 04 listening lesson');
if (audio.lessonId !== lesson.data.lessonId || bank.lessonId !== lesson.data.lessonId || audio.assets.length !== 2 || bank.items.length !== 6) throw new Error('Chapter 04 audio/exercise mismatch');
const { Content } = await render(lesson);
const tracks = audio.assets.map((asset, index) => ({
  id: (index === 0 ? 'a' : 'b') as 'a' | 'b',
  assetId: asset.id,
  label: index === 0 ? 'Selecting Japanese input' : 'Finding a word reading',
  url: asset.mediaPath,
  durationSeconds: asset.durationSeconds,
  transcript: asset.transcript,
  english: asset.english
}));
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Study tools and input methods',href:'/learn/start/module-01/chapter-04/lesson-06/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 04 · Lesson 06</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 04 · LESSON 06</span>
    <h1>Listen to spoken Japanese keyboard instructions.</h1>
    <p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Lessons 01–05 recommended</span><span>Two original WAV dialogues · Six listening questions</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original synthetic Japanese audio.</strong> AivisSpeech 阿井田 茂 (Calm) and morioki (Normal), under ACML 1.0 and applicable model terms. Automated audio integrity checks do not replace independent native Japanese pronunciation review; that review remains pending.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LISTENING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective: string) => <li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <ReusableListeningPractice client:load lessonId="l0-m01-c04-l06" level="l0" version={bank.version} tracks={tracks} questions={bank.items} />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Audio comprehension is distinct from pronunciation. Completion and optional blind listening scores remain browser-local.</p><LessonActions client:load lessonId="l0-m01-c04-l06" level="l0" /></div>
    <div class="lesson-next"><h3>Continue learning</h3><p>Next in Blueprint order: Chapter 04 L07 — writing and typing Japanese classroom requests.</p><a class="btn btn-outline" href="/learn/start/module-01/chapter-04/lesson-05/">← Review reading lesson 05</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a><a class="btn btn-outline" href="/dashboard/">My learning ↗</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">LISTENING STRATEGY</span><h3>Listen first, then read</h3><ol><li>Play both recordings without transcripts.</li><li>Replay the requests and replies.</li><li>Answer six spoken-meaning questions.</li><li>Check the exact evidence and feedback.</li><li>Reveal transcripts for assisted review.</li></ol><p>No microphone or spelling recognition is required. Transcript-assisted attempts are not scored as blind listening.</p></aside></div></section>
</Base>
