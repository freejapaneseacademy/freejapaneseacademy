---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import StudyToolsCheckpointWritten from '../../../../../components/learning/StudyToolsCheckpointWritten';
import StudyToolsCheckpointListening from '../../../../../components/learning/StudyToolsCheckpointListening';
import LessonActions from '../../../../../components/interactive/LessonActions';
import written from '../../../../../content/exercises/l0-m01-c04-chk-written-v1.json';
import listening from '../../../../../content/exercises/l0-m01-c04-chk-listening-v1.json';
import audio from '../../../../../content/audio/l0-m01-c04-l06-v1.json';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/study-tools-input-checkpoint');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c04-chk' || lesson.data.publicationStatus !== 'published' ||
  written.items.length !== 12 || listening.items.length !== 4 || listening.lessonId !== lesson.data.lessonId ||
  audio.assets.length !== 2 || listening.items.some(q => !audio.assets.some(a => a.id === q.stimulusId && a.rights.redistributionCleared && !!a.qa.sha256))) {
  throw new Error('Chapter 04 checkpoint content or licensed audio mismatch');
}
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Chapter 04 checkpoint',href:'/learn/start/module-01/chapter-04/checkpoint/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 04 checkpoint</span></nav><span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 04 · CHECKPOINT</span><h1>Can you enter Japanese and use reading aids?</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>12 written checks · 4 real audio checks</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original mixed-skills checkpoint.</strong> Written and listening results are scored separately; transcript-assisted listening never counts as blind listening. Licensed synthetic AivisSpeech audio is reused unchanged. Independent qualified reviews are pending.</div><div class="lesson-intro"><span class="eyebrow">CHECKPOINT GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o: string) => <li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><StudyToolsCheckpointWritten client:load /><div class="sample-rule"></div><StudyToolsCheckpointListening client:load /><div class="foundation-completion"><h2>Finish Chapter 04</h2><p>Review your answers before marking the checkpoint complete. This is not an official JLPT score.</p><LessonActions client:load lessonId="l0-m01-c04-chk" level="l0" /></div><div class="lesson-next"><h3>Continue Foundations</h3><a class="btn btn-outline" href="/learn/start/module-01/chapter-04/lesson-08/">← Review optional speaking</a><a class="btn btn-primary" href="/learn/start/">All Foundations lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Study tools and input methods</h3><p><strong>L0-M01-C04-CHK</strong></p><ol><li>Review IME, conversion and furigana.</li><li>Answer twelve written questions.</li><li>Listen to two complete licensed dialogues.</li><li>Answer four spoken-meaning questions.</li><li>Review errors and revisit weak items.</li></ol></aside></div></section>
</Base>
