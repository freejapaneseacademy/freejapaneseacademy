---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import StudyToolsScriptPractice from '../../../../../components/interactive/StudyToolsScriptPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/study-tools-input-script-practice');
if(!lesson||lesson.data.lessonId!=='l0-m01-c04-l04')throw new Error('Missing canonical lesson l0-m01-c04-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Script practice',href:'/learn/start/module-01/chapter-04/lesson-04/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 04 · Lesson 04</span></nav><span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 04 · LESSON 04</span><h1>Type the right kana.</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Lesson 03 recommended</span><span>12 written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written practice.</strong> No audio or automatic handwriting/speech scoring. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><StudyToolsScriptPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Mark completion separately from scored practice.</p><LessonActions client:load lessonId="l0-m01-c04-l04" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-01/chapter-04/lesson-03/">← Review lesson 03</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Type and verify</h3><p>Check character size, nasal ん, small っ and kana readings before choosing conversion candidates.</p></aside></div></section>
</Base>