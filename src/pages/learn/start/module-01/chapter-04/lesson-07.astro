---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import StudyToolsWritingPractice from '../../../../../components/interactive/StudyToolsWritingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','l0/study-tools-input-writing');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c04-l07') throw new Error('Missing canonical lesson l0-m01-c04-l07');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Study tools and input methods',href:'/learn/start/module-01/chapter-04/lesson-07/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 04 · Lesson 07</span></nav><span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 04 · LESSON 07</span><h1>Write and type Japanese classroom requests</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>12 scored kana tasks</span><span>3 self-reviewed messages</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original academy writing lesson.</strong> Constrained spellings receive automatic feedback; open messages are learner self-reviewed. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><StudyToolsWritingPractice client:load /><div class="foundation-completion"><h2>Finish this lesson</h2><p>Review your writing and mark the lesson complete. Completion and scored practice are separate local records.</p><LessonActions client:load lessonId="l0-m01-c04-l07" level="l0" /></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 04 L08 — optional speaking and shadowing.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Study tools and input methods</h3><p><strong>L0-M01-C04-L07</strong></p><ol><li>Observe IME models.</li><li>Type twelve Japanese forms.</li><li>Read feedback and revise.</li><li>Compose three polite messages.</li><li>Compare with models and rubric.</li></ol><p>Keep drafts fictional; no personal information.</p></aside></div></section>
</Base>
