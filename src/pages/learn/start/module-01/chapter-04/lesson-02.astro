---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import StudyToolsVocabularyPractice from '../../../../../components/interactive/StudyToolsVocabularyPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/study-tools-input-vocabulary');
if(!lesson||lesson.data.lessonId!=='l0-m01-c04-l02')throw new Error('Missing canonical lesson l0-m01-c04-l02');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Study tools vocabulary',href:'/learn/start/module-01/chapter-04/lesson-02/'}]}>
 <section class="page-hero"><div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 04 · Lesson 02</span></nav>
  <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 04 · LESSON 02</span>
  <h1>Study words.<br/>Ask for help.</h1><p>{lesson.data.description}</p>
  <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Lesson 01 recommended</span><span>12 written questions</span></div>
 </div></section>
 <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
  <div class="course-notice"><strong>Original written vocabulary lesson.</strong> Learn input and reading-aid words in a fictional study exchange. No audio or pronunciation proficiency is assessed. Independent Japanese and assessment reviews remain pending.</div>
  <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
  <article class="lesson-article foundation-article"><Content/></article>
  <StudyToolsVocabularyPractice client:load/>
  <div class="foundation-completion"><h2>Finish this lesson</h2><p>Mark completion separately from your quiz score.</p><LessonActions client:load lessonId="l0-m01-c04-l02" level="l0"/></div>
  <div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 04 lesson 03, sentence function and polite requests.</p><a class="btn btn-outline" href="/learn/start/module-01/chapter-04/lesson-01/">← Review lesson 01</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
 </div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Input versus reading support</h3><p>Review the Japanese words, choose phrases that fit Aya's needs, and compare the written evidence after submitting.</p><p>Real listening belongs to the chapter's later L06 lesson.</p></aside></div></section>
</Base>
