---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ScriptPractice from '../../../../../components/interactive/ScriptPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/japanese-language-map-script-practice');
if(!lesson)throw new Error('Missing blueprint lesson l0-m01-c01-l04');
const {Content}=await render(lesson);
const id=lesson.data.lessonId??'l0-m01-c01-l04';
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Script and kana practice',href:'/learn/start/module-01/chapter-01/lesson-04/'}]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Lesson 04</span></nav><span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 01 · LESSON 04</span><h1>Recognize and type your first kana.</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Lessons 01–03 recommended</span><span>Vowel pairs · typing · optional tracing</span></div></div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original FreeJapaneseAcademy lesson.</strong> Internal screening does not replace independent Japanese-language or assessment review. This is not official JLPT material.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <ScriptPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Compare the scripts, practise kana entry, and complete the check before marking the lesson complete. Completion and accuracy are separate; optional tracing is not graded.</p><LessonActions client:load lessonId={id} level="l0" /></div>
    <div class="lesson-next"><h3>Continue your Japanese Foundations</h3><p>The next step, L05, will practise finding evidence in a script-identification chart.</p><a class="btn btn-outline" href="/learn/start/module-01/chapter-01/lesson-03/">← Review lesson 03</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Japanese language map</h3><p><strong>L0-M01-C01-L04</strong></p><p>Five kana vowel pairs, script identification, real kana entry and optional freehand copying.</p><div class="sample-rule"></div><h3>Study steps</h3><ol><li>Compare five vowel pairs.</li><li>Read classroom word examples.</li><li>Distinguish kanji and furigana.</li><li>Type or select kana.</li><li>Try the optional drawing and check.</li></ol><p>No audio, microphone or kanji-memorization target is included in this L04 step.</p></aside></div></section>
</Base>
