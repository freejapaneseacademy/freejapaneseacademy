---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import VocabularyPractice from '../../../../../components/interactive/VocabularyPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','l0/japanese-language-map-vocabulary');
if (!lesson) throw new Error('Missing blueprint lesson l0-m01-c01-l02');
const { Content } = await render(lesson);
const id = lesson.data.lessonId ?? 'l0-m01-c01-l02';
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Vocabulary and word study',href:'/learn/start/module-01/chapter-01/lesson-02/'}]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Lesson 02</span></nav><span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 01 · LESSON 02</span><h1>Words for your first Japanese classroom.</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Lesson 01 recommended</span><span>Flashcards &amp; word check</span></div></div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original FreeJapaneseAcademy lesson.</strong> Japanese-language and assessment screening was automated; independent human review is still pending. This is not official JLPT content.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <VocabularyPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>When you've studied the words and tried the practice, mark this lesson complete. Completion and quiz accuracy are tracked separately; neither proves pronunciation mastery.</p><LessonActions client:load lessonId={id} level="l0" /></div>
    <div class="lesson-next"><h3>Continue your Japanese Foundations</h3><p>Lesson L03 is ready: see how scripts, particles and verb-final order work in simple sentences.</p><a class="btn btn-primary" href="/learn/start/module-01/chapter-01/lesson-03/">Study lesson 03 ↗</a><a class="btn btn-outline" href="/learn/start/module-01/chapter-01/lesson-01/">← Review lesson 01</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Japanese language map</h3><p><strong>L0-M01-C01-L02</strong></p><p>Script names, classroom terms, and the difference between readings and meanings.</p><div class="sample-rule"></div><h3>Study steps</h3><ol><li>Read each word in context.</li><li>Compare reading and meaning.</li><li>Recall the flashcards.</li><li>Take the interactive check.</li><li>Practise a polite request.</li></ol><p>Audio is not included in this vocabulary step. Pronunciation cues are written guidance only.</p></aside></div></section>
</Base>
