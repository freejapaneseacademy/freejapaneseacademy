---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SentenceFunctionPractice from '../../../../../components/interactive/SentenceFunctionPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/japanese-language-map-sentence-function');
if(!lesson)throw new Error('Missing blueprint lesson l0-m01-c01-l03');
const {Content}=await render(lesson);
const id=lesson.data.lessonId??'l0-m01-c01-l03';
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Grammar and sentence function',href:'/learn/start/module-01/chapter-01/lesson-03/'}]}>
  <section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Lesson 03</span></nav><span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 01 · LESSON 03</span><h1>How Japanese sentences fit together.</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Lessons 01–02 recommended</span><span>Grammar &amp; sentence check</span></div></div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original FreeJapaneseAcademy lesson.</strong> Automated screening is not independent Japanese-language or assessment review. This is not official JLPT content.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <SentenceFunctionPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Study the examples, check your understanding and then mark the lesson complete. Completion and quiz accuracy are tracked separately.</p><LessonActions client:load lessonId={id} level="l0" /></div>
    <div class="lesson-next"><h3>Continue your Japanese Foundations</h3><p>Lesson L04 is ready: recognize and type the kana and written forms introduced here.</p><a class="btn btn-primary" href="/learn/start/module-01/chapter-01/lesson-04/">Study lesson 04 ↗</a><a class="btn btn-outline" href="/learn/start/module-01/chapter-01/lesson-02/">← Review lesson 02</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Japanese language map</h3><p><strong>L0-M01-C01-L03</strong></p><p>Writing-system roles, topic and object particles, verb-final sentence pattern, and polite endings.</p><div class="sample-rule"></div><h3>Study steps</h3><ol><li>Compare the script roles.</li><li>Find は and を.</li><li>Locate the final verb.</li><li>Contrast です and ます.</li><li>Take the interactive check.</li></ol><p>No audio or speaking assessment is included in this grammar step.</p></aside></div></section>
</Base>
