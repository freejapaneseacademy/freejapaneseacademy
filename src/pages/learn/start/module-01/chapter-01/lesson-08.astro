---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SpeakingPractice from '../../../../../components/interactive/SpeakingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/japanese-language-map-speaking');
if (!lesson) throw new Error('Missing blueprint lesson l0-m01-c01-l08');
const { Content } = await render(lesson);
const id = lesson.data.lessonId ?? 'l0-m01-c01-l08';
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Speaking and shadowing',href:'/learn/start/module-01/chapter-01/lesson-08/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Lesson 08</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 01 · LESSON 08</span>
    <h1>Say how Japanese writing works.</h1>
    <p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Lessons 01–07 recommended</span><span>Optional speaking · Real model audio · Private recording</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original FreeJapaneseAcademy speaking workshop.</strong> Model audio is the existing L06 synthetic narration, not a new human recording. Independent Japanese pronunciation and assessment reviews are pending. Speaking is optional and is not part of the official JLPT.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR SPEAKING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective: string) => <li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <SpeakingPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>When you have reviewed the four writing systems, you may mark this lesson complete whether or not you use the microphone or optional phrase-choice check. Completion is separate from your speaking self-review and saved choice scores.</p><LessonActions client:load lessonId={id} level="l0" /></div>
    <div class="lesson-next"><h3>Continue Japanese Foundations</h3><p>Next in blueprint order: the Chapter 01 mixed checkpoint. It has not yet been published.</p><a class="btn btn-outline" href="/learn/start/module-01/chapter-01/lesson-07/">← Review lesson 07</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons ↗</a></div>
  </div><aside class="lesson-side foundation-side">
    <span class="eyebrow">STUDY GUIDE</span><h3>Japanese language map</h3><p><strong>L0-M01-C01-L08</strong></p>
    <p>Shadow the real narrated models, then explain the four writing systems using short Japanese phrases and English support.</p>
    <div class="sample-rule"></div><h3>Study steps</h3><ol><li>Listen to the two complete models.</li><li>Pause and repeat short Japanese phrases.</li><li>Point to four cards while explaining their roles.</li><li>Try the optional phrase-choice check.</li><li>Optionally record locally and compare with the model.</li><li>Complete an honest self-review.</li></ol>
    <p>Microphone access is optional. No automated speaking grade, personal audio upload or new audio asset is included.</p>
  </aside></div></section>
</Base>
