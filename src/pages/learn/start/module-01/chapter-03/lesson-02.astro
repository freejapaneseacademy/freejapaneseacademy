---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RhythmVocabularyPractice from '../../../../../components/interactive/RhythmVocabularyPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons', 'l0/sound-changes-rhythm-vocabulary');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c03-l02') throw new Error('Missing canonical lesson l0-m01-c03-l02');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Sound changes and rhythm',href:'/learn/start/module-01/chapter-03/lesson-02/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 03 · Lesson 02</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 03 · LESSON 02</span>
    <h1>Small changes.<br/>Different words.</h1>
    <p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Chapter 03 lesson 01 recommended</span><span>Eight written questions</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original academy word study.</strong> This step checks written word meanings and mora counting, not hearing or pronunciation. Independent Japanese and assessment reviews remain pending.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <RhythmVocabularyPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Review the vocabulary and complete the written check. Lesson completion and quiz attempts are saved separately on this device.</p><LessonActions client:load lessonId="l0-m01-c03-l02" level="l0" /></div>
    <div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 03 L03 — use long vowels, small っ and ん to understand sentence meaning.</p><a class="btn btn-primary" href="/learn/start/module-01/chapter-03/lesson-03/">Study lesson 03 ↗</a><a class="btn btn-outline" href="/learn/start/">All Foundations lessons</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
  </div><aside class="lesson-side foundation-side">
    <span class="eyebrow">YOUR STUDY GUIDE</span><h3>Sound changes and rhythm</h3><p><strong>L0-M01-C03-L02</strong></p>
    <ol><li>Compare family terms with long vowels.</li><li>Study small っ word pairs.</li><li>Count ん as one mora.</li><li>Try the eight-question written check.</li><li>Retrieve four forms without looking.</li></ol>
    <p>Audio comprehension is taught in the dedicated later listening lesson. No microphone or speech grading is used here.</p>
  </aside></div></section>
</Base>
