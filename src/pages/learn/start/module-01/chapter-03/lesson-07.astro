---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SoundChangeWritingPractice from '../../../../../components/interactive/SoundChangeWritingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons', 'l0/sound-changes-rhythm-writing');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c03-l07') throw new Error('Missing canonical lesson l0-m01-c03-l07');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Sound changes and rhythm',href:'/learn/start/module-01/chapter-03/lesson-07/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 03 · Lesson 07</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 03 · LESSON 07</span>
    <h1>Write the rhythm: meaningful kana messages</h1><p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>12 scored kana labels</span><span>3 self-reviewed messages</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original academy writing lesson.</strong> Exact spelling feedback for constrained kana tasks; longer writing is self-reviewed. No automatic handwriting, pronunciation or open-response grading. Independent Japanese and assessment reviews pending.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <SoundChangeWritingPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Compare your writing to the models, revise, then mark this lesson complete. Completion and scored practice are separate local progress records.</p><LessonActions client:load lessonId="l0-m01-c03-l07" level="l0" /></div>
    <div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 03 L08 — optional speaking and shadowing.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Sound changes and rhythm</h3><p><strong>L0-M01-C03-L07</strong></p><ol><li>Read the model contrasts.</li><li>Compose short kana labels.</li><li>Check spelling feedback.</li><li>Write three supported messages.</li><li>Compare with models and revise.</li></ol><p>Use a Japanese keyboard; never enter personal information.</p></aside></div></section>
</Base>
