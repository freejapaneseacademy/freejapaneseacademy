---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SoundChangeReadingPractice from '../../../../../components/interactive/SoundChangeReadingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons', 'l0/sound-changes-rhythm-reading');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c03-l05') throw new Error('Missing canonical lesson l0-m01-c03-l05');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Sound changes and rhythm',href:'/learn/start/module-01/chapter-03/lesson-05/'}]}>
 <section class="page-hero"><div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 03 · Lesson 05</span></nav>
  <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 03 · LESSON 05</span>
  <h1>Read the rhythm: evidence in Japanese captions</h1><p>{lesson.data.description}</p>
  <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Chapter 03 lessons 01–04 recommended</span><span>12 scored reading questions</span></div>
 </div></section>
 <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
  <div class="course-notice"><strong>Original academy reading lesson.</strong> The eight captions and their questions assess written evidence, not listening or pronunciation. Independent Japanese and assessment reviews are pending.</div>
  <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
  <article class="lesson-article foundation-article"><Content /></article>
  <SoundChangeReadingPractice client:load />
  <div class="foundation-completion"><h2>Finish this lesson</h2><p>Review each evidence explanation, then mark the lesson complete. Your quiz attempts and completion are stored separately on this device.</p><LessonActions client:load lessonId="l0-m01-c03-l05" level="l0" /></div>
  <div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 03 L06 — genuine audio discrimination.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
 </div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Sound changes and rhythm</h3><p><strong>L0-M01-C03-L05</strong></p><ol><li>Read the eight caption cards.</li><li>Identify the meaningful kana contrasts.</li><li>Choose evidence for twelve questions.</li><li>Review each rationale.</li><li>Write two short self-checked comparisons.</li></ol><p>Written evidence is not proof of listening comprehension.</p></aside></div></section>
</Base>
