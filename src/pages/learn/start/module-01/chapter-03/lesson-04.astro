---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SoundChangeScriptPractice from '../../../../../components/interactive/SoundChangeScriptPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';

const lesson = await getEntry('lessons', 'l0/sound-changes-rhythm-script-practice');
if (!lesson || lesson.data.lessonId !== 'l0-m01-c03-l04') throw new Error('Missing canonical lesson l0-m01-c03-l04');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Sound changes and rhythm',href:'/learn/start/module-01/chapter-03/lesson-04/'}]}>
  <section class="page-hero"><div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Chapter 03 · Lesson 04</span></nav>
    <span class="eyebrow">LEVEL 0 · MODULE 01 · CHAPTER 03 · LESSON 04</span>
    <h1>Write the rhythm: long vowels, small っ and ん.</h1>
    <p>{lesson.data.description}</p>
    <div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Chapter 03 lessons 01–03 recommended</span><span>Twelve scored kana tasks</span></div>
  </div></section>
  <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
    <div class="course-notice"><strong>Original academy lesson.</strong> Written kana practice only. No automatic pronunciation or handwriting grading. Independent Japanese-language and assessment reviews remain pending.</div>
    <div class="lesson-intro"><span class="eyebrow">YOUR LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
    <article class="lesson-article foundation-article"><Content /></article>
    <SoundChangeScriptPractice client:load />
    <div class="foundation-completion"><h2>Finish this lesson</h2><p>Review your typing feedback, then mark the lesson complete. Written scores and completion are separate local progress records.</p><LessonActions client:load lessonId="l0-m01-c03-l04" level="l0" /></div>
    <div class="lesson-next"><h3>Continue learning</h3><p>Next: Chapter 03 L05 — reading and context evidence.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div>
  </div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Sound changes and rhythm</h3><p><strong>L0-M01-C03-L04</strong></p><ol><li>Compare the printed word pairs.</li><li>Count each mora.</li><li>Type the twelve kana answers.</li><li>Read the answer explanations.</li><li>Optionally trace small っ and ん on paper.</li></ol><p>Listening comprehension requires real recordings in a separate lesson.</p></aside></div></section>
</Base>
