---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import FoundationWritingStudio from '../../../../../components/interactive/FoundationWritingStudio';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/foundation-writing-studio');
if(!lesson||lesson.data.lessonId!=='l0-m05-c04-l07')throw new Error('Missing canonical lesson l0-m05-c04-l07');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Foundation writing',href:'/learn/start/module-05/chapter-04/lesson-07/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 05 · Chapter 04 · Lesson 07</span></nav><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 04 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Ten scored writing checks</span><span>Private study plan</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original written practice.</strong> No free composition is automatically graded. Independent Japanese and assessment reviews are pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><FoundationWritingStudio client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and writing attempts are recorded separately on this device.</p><LessonActions client:load lessonId="l0-m05-c04-l07" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: optional speaking and shadowing.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Write, compare, correct</h3><p>Check small kana, long vowels, and voiced marks before retrying. A small consistent routine is enough to begin.</p></aside></div></section>
</Base>
