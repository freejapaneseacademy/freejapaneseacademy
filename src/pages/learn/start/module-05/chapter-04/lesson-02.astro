---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import FoundationReviewVocabularyPractice from '../../../../../components/interactive/FoundationReviewVocabularyPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','l0/foundation-review-vocabulary');
if (!lesson || lesson.data.lessonId !== 'l0-m05-c04-l02') throw new Error('Missing canonical lesson l0-m05-c04-l02');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Foundation review',href:'/learn/start/module-05/chapter-04/lesson-02/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 05 · Chapter 04 · Lesson 02</span></nav><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 04 · LESSON 02</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written vocabulary review</span><span>Twelve questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner word study.</strong> Independent Japanese and assessment reviews are pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><FoundationReviewVocabularyPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and scored attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m05-c04-l02" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: using self-correction and study-planning patterns.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Notice · Repair · Return</h3><p>Read in context, locate the exact kana difference, then retrieve again without the model.</p></aside></div></section>
</Base>