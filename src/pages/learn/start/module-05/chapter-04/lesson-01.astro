---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import FoundationReviewContextPractice from '../../../../../components/interactive/FoundationReviewContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/foundation-review-context');
if(!lesson)throw new Error('Missing l0-m05-c04-l01');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={false} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Foundation review',href:'/learn/start/module-05/chapter-04/lesson-01/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 04 · LESSON 01</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy lesson. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><h2>Learning goals</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><FoundationReviewContextPractice client:load/><div class="foundation-completion"><h2>Finish the lesson</h2><LessonActions client:load lessonId="l0-m05-c04-l01" level="l0"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/start/module-05/chapter-03/checkpoint/">Previous checkpoint</a><a class="btn btn-primary" href="/learn/start/module-05/chapter-04/lesson-02/">Next lesson</a></div></div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Read the diary, compare kana markers and plan a short review.</p><p>No audio is required for this written lesson.</p></aside></div></section>
</Base>