---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/FoundationCheckpoint';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/foundation-chapter-checkpoint');
if(!lesson)throw new Error('Missing l0-m05-c04-chk');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Foundation assessment and study habits',href:'/learn/start/'}]}>
<section class="page-hero"><div class="container"><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 04 · CHECKPOINT</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Mixed written checkpoint</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice">Original academy practice. Independent Japanese and assessment reviews pending; not official JLPT material.</div><div class="lesson-intro"><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><Practice client:load /><div class="foundation-completion"><h2>Finish this checkpoint</h2><p>Completion is separate from your written score.</p><LessonActions client:load lessonId="l0-m05-c04-chk" level="l0" /></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><h3>Review wisely</h3><p>Locate evidence, repair one spelling error, and revisit it later.</p><p>Actual listening practice is in L06; no new audio is generated or graded here.</p></aside></div></section>
</Base>
