---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import ReusableListeningPractice from '../../../../../components/interactive/ReusableListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import exercise from '../../../../../content/exercises/l0-m05-c04-l06.json';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons', 'l0/foundation-listening-review');
if (!lesson || lesson.data.lessonId !== 'l0-m05-c04-l06') throw new Error('Missing canonical listening review');
const { Content } = await render(lesson);
const audioPaths = ['/audio/fja-l0-m05-c04-l06-a-v1.wav','/audio/fja-l0-m05-c04-l06-b-v1.wav'];
const manifestModules = import.meta.glob('../../../../../content/audio/l0-m05-c04-l06-v1.json', { eager: true, import: 'default' });
const manifest = Object.values(manifestModules)[0] as { assets: Array<{id:string;mediaPath:string;durationSeconds:number;transcript:string;english:string}> } | undefined;
const tracks = manifest?.assets.map((asset, i) => ({
 id: (i===0?'a':'b') as 'a'|'b', assetId: asset.id,
 label: i===0?'Track A — Before class':'Track B — After class',
 url: asset.mediaPath, durationSeconds: asset.durationSeconds,
 transcript: asset.transcript, english: asset.english
})) ?? ['a','b'].map((key,i)=>({id:key as 'a'|'b',assetId:'audio-l0-m05-c04-l06-'+key,label:i===0?'Track A — Before class':'Track B — After class',url:audioPaths[i],durationSeconds:0,transcript:'Audio generation pending.',english:'Audio generation pending.'}));
const questions = exercise.items.map(item => ({id:item.id,trackId:item.trackId,prompt:item.prompt,choices:item.choices,answerKey:item.answerKey,explanation:item.explanation,evidence:item.evidence}));
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'}]}>
<section class="page-hero"><div class="container"><p class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 04 · LESSON 06</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p></div></section>
<main class="container min-w-0 py-8"><article class="lesson-prose min-w-0"><Content /></article><div class="my-10 min-w-0"><ReusableListeningPractice client:load lessonId="l0-m05-c04-l06" level="l0" version={1} tracks={tracks} questions={questions} /></div><LessonActions client:load lessonId="l0-m05-c04-l06" level="l0" /></main>
</Base>
