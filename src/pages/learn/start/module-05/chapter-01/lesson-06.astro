---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import GreetingListeningPractice from '../../../../../components/interactive/GreetingListeningPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','l0/greeting-classroom-listening');
if (!lesson || lesson.data.lessonId !== 'l0-m05-c01-l06') throw new Error('Missing canonical lesson l0-m05-c01-l06');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'First Contact with Japanese',href:'/learn/start/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 05 · Chapter 01 · Lesson 06</span></nav><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 01 · LESSON 06</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Two original conversations</span><span>Six listening questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Listening practice.</strong> Audio integrity must be verified before publication; independent Japanese and pronunciation reviews are pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><GreetingListeningPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and listening attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m05-c01-l06" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">LISTENING STRATEGY</span><h3>First sound, then text</h3><p>Listen for the greeting, the request before ください, and the response. Reveal the transcript only after your first listening attempt.</p></aside></div></section>
</Base>
