---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import GreetingClassroomShadowing from '../../../../../components/interactive/GreetingClassroomShadowing';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','l0/greeting-classroom-shadowing');
if (!lesson) throw new Error('Missing l0-m05-c01-l08');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} noindex={true} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Optional classroom speaking',href:'/learn/start/module-05/chapter-01/lesson-08/'}]}>
 <section class="page-hero"><div class="container"><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 01 · LESSON 08</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><p>About {lesson.data.minutes} minutes · Optional speaking · Genuine L06 audio required for shadowing</p></div></section>
 <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
 <div class="course-notice">Original academy lesson. No automated pronunciation grade or independent human pronunciation review is claimed. Speaking and microphone use are optional.</div>
 <div class="lesson-intro"><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div>
 <article class="lesson-article foundation-article"><Content /></article>
 <GreetingClassroomShadowing client:load />
 <div class="foundation-completion"><h2>Finish the lesson</h2><p>Mark completion after studying the expressions. Recording and optional speaking are not required.</p><LessonActions client:load lessonId="l0-m05-c01-l08" level="l0"/></div>
 <div class="lesson-next"><a class="btn btn-outline" href="/learn/start/module-05/chapter-01/lesson-07/">Review writing</a><a class="btn btn-primary" href="/learn/start/module-05/chapter-01/checkpoint/">Chapter checkpoint</a></div>
 </div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Listen to both original L06 dialogues, rehearse the learner and teacher roles, and reflect privately. Audio is required for true shadowing.</p></aside></div></section>
</Base>
