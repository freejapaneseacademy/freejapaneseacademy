---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RegistrationKanaPractice from '../../../../../components/interactive/RegistrationKanaPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/registration-kana-script');
if(!lesson||lesson.data.lessonId!=='l0-m05-c02-l04')throw new Error('Missing canonical lesson l0-m05-c02-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'}]}>
 <section class="page-hero"><div class="container"><p class="eyebrow">Level 0 · Module 05 · Chapter 02 · Lesson 04</p><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p></div></section>
 <main class="container min-w-0 py-8"><article class="lesson-prose min-w-0"><Content /></article><div class="my-10 min-w-0"><RegistrationKanaPractice client:load /></div><LessonActions client:load lessonId="l0-m05-c02-l04" level="l0" /></main>
</Base>
