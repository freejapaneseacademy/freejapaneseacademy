---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import Practice from '../../../../../components/interactive/NumbersPersonalDetailsVocabularyPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson = await getEntry('lessons','l0/numbers-personal-details-vocabulary');
if (!lesson) throw new Error('Missing l0-m05-c02-l02');
const { Content } = await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Numbers and personal details',href:'/learn/start/module-05/chapter-02/lesson-02/'}]}>
 <section class="page-hero"><div class="container"><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 02 · LESSON 02</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>{lesson.data.minutes} minutes</span><span>Written vocabulary practice</span></div></div></section>
 <section class="page-body"><div class="container foundation-lesson"><div class="foundation-main">
  <div class="course-notice">Original FreeJapaneseAcademy lesson. Independent Japanese-language and assessment reviews remain pending; this is not official JLPT material.</div>
  <div class="lesson-intro"><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((objective:string)=><li>{objective}</li>)}</ul></div>
  <article class="lesson-article foundation-article"><Content /></article>
  <Practice client:load />
  <div class="foundation-completion"><h2>Finish this lesson</h2><p>Complete the reading practice, then mark this lesson complete. Completion is separate from quiz accuracy.</p><LessonActions client:load lessonId="l0-m05-c02-l02" level="l0" /></div>
  <div class="lesson-next"><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div>
 </div><aside class="lesson-side foundation-side"><h3>Study guide</h3><p>Build tens before units. Separate a country from a nationality and a registration number from age.</p><p>No listening recording is required for this written vocabulary lesson.</p></aside></div></section>
</Base>
