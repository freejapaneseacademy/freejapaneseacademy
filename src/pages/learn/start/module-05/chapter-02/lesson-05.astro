---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RegistrationFormReading from '../../../../../components/interactive/RegistrationFormReading';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/registration-form-reading');
if(!lesson||lesson.data.lessonId!=='l0-m05-c02-l05')throw new Error('Missing canonical registration reading lesson');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Numbers and personal details',href:'/learn/start/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 05 · Chapter 02 · Lesson 05</span></nav><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 02 · LESSON 05</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written reading</span><span>Ten scored questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner reading lesson.</strong> Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><RegistrationFormReading client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and scored attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m05-c02-l05" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Find the label, then the value</h3><p>Check the printed Japanese field name before choosing a detail. Names do not establish nationality.</p></aside></div></section>
</Base>
