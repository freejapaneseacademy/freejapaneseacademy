---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import RegistrationContextPractice from '../../../../../components/interactive/RegistrationContextPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/numbers-personal-details-context');
if(!lesson||lesson.data.lessonId!=='l0-m05-c02-l01')throw new Error('Missing canonical lesson l0-m05-c02-l01');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 05 · Chapter 02 · Lesson 01</span></nav><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 02 · LESSON 01</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written context</span><span>Ten questions</span></div></div></section><section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner lesson.</strong> Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content /></article><RegistrationContextPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion is separate from the written quiz score.</p><LessonActions client:load lessonId="l0-m05-c02-l01" level="l0"/></div><div class="lesson-next"><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><h3>Read the label first</h3><p>Never assume a number means age or a country proves nationality.</p></aside></div></section>
</Base>
