---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import MiniSelfIntroReading from '../../../../../components/interactive/MiniSelfIntroReading';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/mini-self-intro-reading');
if(!lesson||lesson.data.lessonId!=='l0-m05-c03-l05')throw new Error('Missing canonical mini self-intro reading lesson');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'First sentence patterns',href:'/learn/start/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 05 · Chapter 03 · Lesson 05</span></nav><span class="eyebrow">LEVEL 0 · MODULE 05 · CHAPTER 03 · LESSON 05</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Written reading</span><span>Ten scored questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner reading lesson.</strong> Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><MiniSelfIntroReading client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and scored attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m05-c03-l05" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Read the reply, not just the question</h3><p>Locate the speaker, then the statement or question, then the evidence in the reply. Do not infer unstated facts.</p></aside></div></section>
</Base>