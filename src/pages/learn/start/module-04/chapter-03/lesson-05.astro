---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import KatakanaVoicedStoreReadingPractice from '../../../../../components/interactive/KatakanaVoicedStoreReadingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/katakana-voiced-store-reading');
if(!lesson||lesson.data.lessonId!=='l0-m04-c03-l05')throw new Error('Missing canonical lesson l0-m04-c03-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Katakana',href:'/learn/start/module-04/chapter-03/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 04 · Chapter 03 · Lesson 05</span></nav><span class="eyebrow">LEVEL 0 · MODULE 04 · CHAPTER 03 · LESSON 05</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Original written store board</span><span>Eight evidence questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner reading lesson.</strong> Written evidence only; independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><KatakanaVoicedStoreReadingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m04-c03-l05" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: authentic pronunciation audio in Lesson 06.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Katakana · Store reading</h3><p>Find the label, cite the printed evidence, and check sound marks.</p></aside></div></section>
</Base>
