---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import KatakanaVoicedWritingPractice from '../../../../../components/interactive/KatakanaVoicedWritingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/katakana-voiced-writing');
if(!lesson||lesson.data.lessonId!=='l0-m04-c03-l07')throw new Error('Missing canonical lesson l0-m04-c03-l07');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Katakana',href:'/learn/start/module-04/chapter-03/lesson-07/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 04 · Chapter 03 · Lesson 07</span></nav><span class="eyebrow">LEVEL 0 · MODULE 04 · CHAPTER 03 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Eight scored writing checks</span><span>Optional self-reviewed note</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original writing practice.</strong> No creative composition is auto-graded. Independent language and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><KatakanaVoicedWritingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Lesson completion and written attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m04-c03-l07" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: optional shadowing of katakana shop expressions.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Written shop labels</h3><p>Inspect the small circle, dakuten strokes, and the ン/ソ contrast before saving.</p></aside></div></section>
</Base>