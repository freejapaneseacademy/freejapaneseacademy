---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import LoanwordScriptPractice from '../../../../../components/interactive/LoanwordScriptPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/katakana-loanword-script');
if(!lesson||lesson.data.lessonId!=='l0-m04-c04-l04')throw new Error('Missing canonical lesson l0-m04-c04-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Katakana loanwords',href:'/learn/start/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 04 · Chapter 04 · Lesson 04</span></nav><span class="eyebrow">LEVEL 0 · MODULE 04 · CHAPTER 04 · LESSON 04</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Katakana script and typing</span><span>Ten scored written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Written katakana practice.</strong> No recorded audio or pronunciation grade is claimed. Independent reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><LoanwordScriptPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and written quiz attempts are saved separately on this device.</p><LessonActions client:load lessonId="l0-m04-c04-l04" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: read an original station café menu and find evidence.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Loanword spelling</h3><p>Check long-vowel marks and small vowel kana before printing a sign. Use Japanese IME for optional typing.</p></aside></div></section>
</Base>