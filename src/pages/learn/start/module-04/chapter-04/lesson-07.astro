---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import LoanwordSignWriting from '../../../../../components/interactive/LoanwordSignWriting';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/katakana-loanword-sign-writing');
if(!lesson||lesson.data.lessonId!=='l0-m04-c04-l07')throw new Error('Missing canonical lesson l0-m04-c04-l07');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Katakana loanwords',href:'/learn/start/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 04 · Chapter 04 · Lesson 07</span></nav><span class="eyebrow">LEVEL 0 · MODULE 04 · CHAPTER 04 · LESSON 07</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Guided typing + self-reviewed writing</span><span>Eight scored spellings</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Writing practice.</strong> The composition is learner self-reviewed; no teacher or pronunciation assessment is claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><LoanwordSignWriting client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and typing attempts are saved separately on this device.</p><LessonActions client:load lessonId="l0-m04-c04-l07" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: optional shadowing with verified chapter audio.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Check the small kana</h3><p>Compare ティ with テイ, ファ with フア, and the two long-vowel marks in コーヒー.</p></aside></div></section>
</Base>