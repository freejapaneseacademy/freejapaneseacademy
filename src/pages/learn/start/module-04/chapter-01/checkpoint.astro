---
import {getEntry,render} from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import KatakanaKioskCheckpoint from '../../../../../components/interactive/KatakanaKioskCheckpoint';
import LessonActions from '../../../../../components/interactive/LessonActions';
import bank from '../../../../../content/exercises/l0-m04-c01-chk.json';
import manifest from '../../../../../content/audio/l0-m04-c01-l06-v1.json';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/katakana-kiosk-checkpoint');
if(!lesson||lesson.data.lessonId!=='l0-m04-c01-chk'||bank.lessonId!==lesson.data.lessonId||bank.items.length!==12||manifest.assets.length!==2||manifest.assets.some(a=>!a.rights.redistributionCleared||!a.qa.sha256||a.turns.length<4))throw new Error('Incomplete katakana checkpoint or unverified L06 audio manifest');
const {Content}=await render(lesson);
const tracks=manifest.assets.map((a,i)=>({id:a.id,label:i?'Track B — Ice cream':'Track A — Hot cocoa',url:a.mediaPath,transcript:a.transcript,english:a.english}));
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Katakana checkpoint',href:'/learn/start/module-04/chapter-01/checkpoint/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 04 · Chapter 01 · Checkpoint</span></nav><span class="eyebrow">LEVEL 0 · MODULE 04 · CHAPTER 01 · CHECKPOINT</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>12 scored questions</span><span>2 original audio tracks</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original mixed checkpoint.</strong> Independent Japanese pronunciation and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><KatakanaKioskCheckpoint client:load questions={bank.items} tracks={tracks}/><div class="foundation-completion"><h2>Finish Chapter 01</h2><p>Assessment attempts and lesson completion are stored separately on this device.</p><LessonActions client:load lessonId="l0-m04-c01-chk" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/module-04/chapter-01/lesson-07/">Review writing</a><a class="btn btn-outline" href="/learn/start/">Foundations overview</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Read, listen, explain</h3><p>Written and spoken evidence are separate skills. Assisted transcripts are labelled.</p></aside></div></section>
</Base>