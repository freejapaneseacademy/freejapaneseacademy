---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import KatakanaShadowingPractice from '../../../../../components/interactive/KatakanaShadowingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/katakana-vowels-kst-speaking');
if(!lesson||lesson.data.lessonId!=='l0-m04-c01-l08')throw new Error('Missing canonical l0-m04-c01-l08');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Katakana Fundamentals',href:'/learn/start/module-04/chapter-01/lesson-08/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 04 · Chapter 01 · Lesson 08</span></nav><span class="eyebrow">LEVEL 0 · MODULE 04 · CHAPTER 01 · LESSON 08</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Optional speaking rehearsal</span><span>Eight written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Model audio required.</strong> This lesson reuses the two genuine Chapter 01 L06 WAVs after integrity validation. No microphone, automatic pronunciation grade or human review claimed.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><KatakanaShadowingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and written score are stored separately on this device.</p><LessonActions client:load lessonId="l0-m04-c01-l08" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Rehearse with verified recordings</h3><p>Pause and repeat actual recorded syllables. The written quiz is not a pronunciation score.</p></aside></div></section>
</Base>