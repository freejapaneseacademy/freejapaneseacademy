---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import YoonReadingPractice from '../../../../../components/interactive/YoonReadingPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-yoon-reading');
if(!lesson||lesson.data.lessonId!=='l0-m03-c02-l05')throw new Error('Missing canonical lesson l0-m03-c02-l05');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana II',href:'/learn/start/module-03/chapter-02/lesson-05/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 03 · Chapter 02 · Lesson 05</span></nav><span class="eyebrow">LEVEL 0 · MODULE 03 · CHAPTER 02 · LESSON 05</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Sound-family chart reading</span><span>Ten evidence questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner reading.</strong> Written chart and labels only; independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><YoonReadingPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m03-c02-l05" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: real recorded syllable listening in Lesson 06.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Hiragana II · Chart reading</h3><p>Locate the exact row, small-kana column and printed card that support your answer.</p></aside></div></section>
</Base>