---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import HiraganaSentenceShadowing from '../../../../../components/interactive/HiraganaSentenceShadowing';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
import '../../../../../styles/vowel-speaking.css';
const lesson=await getEntry('lessons','l0/hiragana-sentence-reading-speaking');
if(!lesson||lesson.data.lessonId!=='l0-m03-c04-l08')throw new Error('Missing canonical speaking lesson');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana shadowing',href:'/learn/start/module-03/chapter-04/lesson-08/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 03 · Chapter 04 · Lesson 08</span></nav><span class="eyebrow">LEVEL 0 · MODULE 03 · CHAPTER 04 · LESSON 08</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Two model dialogues (release requires verified audio)</span><span>Optional speaking</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Optional rehearsal, not a pronunciation grade.</strong> The release queue must verify both licensed Lesson 06 WAV recordings before publishing. Independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><HiraganaSentenceShadowing client:load/><div class="foundation-completion"><h2>Finish this optional lesson</h2><p>Completion is independent of microphone access or score.</p><LessonActions client:load lessonId="l0-m03-c04-l08" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Listen · repeat · reflect</h3><p>Practise both roles. Recording is strictly optional and never uploaded.</p></aside></div></section>
</Base>
