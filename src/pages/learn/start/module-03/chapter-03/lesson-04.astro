---
import { getEntry, render } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import SmallTsuScriptPractice from '../../../../../components/interactive/SmallTsuScriptPractice';
import LessonActions from '../../../../../components/interactive/LessonActions';
import '../../../../../styles/foundations.css';
const lesson=await getEntry('lessons','l0/hiragana-small-tsu-script-practice');
if(!lesson||lesson.data.lessonId!=='l0-m03-c03-l04')throw new Error('Missing canonical lesson l0-m03-c03-l04');
const {Content}=await render(lesson);
---
<Base title={lesson.data.title} description={lesson.data.description} breadcrumbs={[{label:'Courses',href:'/learn/'},{label:'Foundations',href:'/learn/start/'},{label:'Hiragana II',href:'/learn/start/module-03/chapter-03/lesson-04/'}]}>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>›</span><a href="/learn/">Courses</a><span>›</span><a href="/learn/start/">Foundations</a><span>›</span><span>Module 03 · Chapter 03 · Lesson 04</span></nav><span class="eyebrow">LEVEL 0 · MODULE 03 · CHAPTER 03 · LESSON 04</span><h1>{lesson.data.title}</h1><p>{lesson.data.description}</p><div class="foundation-meta"><span>About {lesson.data.minutes} minutes</span><span>Small っ and long vowels</span><span>Ten written questions</span></div></div></section>
<section class="page-body"><div class="container foundation-lesson"><div class="foundation-main"><div class="course-notice"><strong>Original beginner lesson.</strong> Written kana recognition and typing only; independent Japanese and assessment reviews pending.</div><div class="lesson-intro"><span class="eyebrow">LEARNING GOALS</span><h2>By the end, you can…</h2><ul>{lesson.data.objectives.map((o:string)=><li>{o}</li>)}</ul></div><article class="lesson-article foundation-article"><Content/></article><SmallTsuScriptPractice client:load/><div class="foundation-completion"><h2>Finish this lesson</h2><p>Completion and quiz attempts are stored separately on this device.</p><LessonActions client:load lessonId="l0-m03-c03-l04" level="l0"/></div><div class="lesson-next"><h3>Continue learning</h3><p>Next: paired-word-list reading, once published.</p><a class="btn btn-outline" href="/learn/start/">Foundations overview</a><a class="btn btn-outline" href="/dashboard/">My learning</a></div></div><aside class="lesson-side foundation-side"><span class="eyebrow">STUDY GUIDE</span><h3>Hiragana II · Small tsu</h3><p>Check the size of っ and verify every vowel in the IME output.</p></aside></div></section>
</Base>
