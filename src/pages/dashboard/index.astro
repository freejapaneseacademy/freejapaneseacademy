---
import Base from '../../layouts/Base.astro';
import ProgressPanel from '../../components/interactive/ProgressPanel';
---
<Base title="My Learning Dashboard" description="Track your Japanese learning, review saved quiz scores, manage bookmarks and export your progress from this browser." noindex={true}>
  <div class="dashboard-shell"><section class="page-hero"><div class="container"><span class="eyebrow">YOUR PERSONAL LEARNING SPACE</span><h1>Every little step<br/>counts.</h1><p>This is your space to see how far you've come, celebrate small wins, and keep moving forward. Everything stays in this browser.</p></div></section><div class="container page-body"><ProgressPanel client:load /></div></div>
</Base>
