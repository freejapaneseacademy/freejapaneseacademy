---
import Base from '../layouts/Base.astro';
import { levels } from '../lib/curriculum';
---
<Base title="FreeJapaneseAcademy" description="Learn Japanese from absolute beginner to advanced. Discover free, structured Japanese courses, lessons, practice and progress tracking.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">A different way to learn Japanese</span>
        <h1>A whole new world starts with <em>one word.</em></h1>
        <p class="lead">From your first hiragana to the nuances of JLPT N1. A thoughtful, step-by-step Japanese learning journey—open to everyone, completely free.</p>
        <div class="hero-actions"><a class="btn btn-primary" href="/learn/n5/">Start learning for free <span aria-hidden="true">↗</span></a><a class="btn btn-outline" href="/learn/">Explore the pathway <span aria-hidden="true">→</span></a></div>
        <div class="hero-notes"><span><b class="tiny-check">✓</b> No account needed</span><span><b class="tiny-check">✓</b> Learn at your pace</span><span><b class="tiny-check">✓</b> Always free</span></div>
      </div>
      <div class="hero-visual" aria-label="Preview of a Japanese lesson card">
        <span class="hero-jp" lang="ja" aria-hidden="true">学</span>
        <div class="hero-card">
          <div class="hero-card-head"><span>YOUR FIRST JAPANESE LESSON</span><b>N5 · BEGINNER</b></div>
          <div class="hero-card-body">
            <small>LESSON PREVIEW / 01</small><h3>It's nice to meet you.</h3>
            <div class="hero-japanese" lang="ja"><ruby>初<rt>はじ</rt></ruby>めまして。</div>
            <p>Hajimemashite. — Nice to meet you.</p>
            <div class="hero-card-progress"><span>A little every day adds up.</span><span>✦</span></div>
            <div class="hero-card-line"></div>
          </div>
        </div>
        <div class="floating-note"><strong>あいうえお</strong> &nbsp; Your journey begins here.</div>
      </div>
    </div>
  </section>
  <div class="trust-strip"><div class="container trust-inner"><span><b aria-hidden="true">✳</b> From first character to N1</span><span><b aria-hidden="true">◌</b> Built for real understanding</span><span><b aria-hidden="true">花</b> Save progress in your browser</span><span><b aria-hidden="true">∞</b> Education without a paywall</span></div></div>
  <section class="section" id="pathway"><div class="container">
    <div class="section-head"><div><span class="eyebrow">YOUR LEARNING PATHWAY</span><h2>Five levels.<br/>One beautiful journey.</h2></div><p class="lead">A complete learning pathway is in development. Explore the level structure and try our first live N5 demonstration lesson.</p></div>
    <div class="course-grid">{levels.map(level => <a href={`/learn/${level.id}/`} class={`course-card tone-${level.tone}`} aria-label={`Explore JLPT ${level.label}: ${level.stage}`}><span class="course-num">{level.rank}</span><div class="course-symbol" aria-hidden="true">{level.label}</div><strong>{level.name}</strong><small>{level.stage}</small><div class="course-bottom"><span>Explore {level.label}</span><span aria-hidden="true">↗</span></div></a>)}</div>
    <p class="muted" style="margin-top:19px">Preview pathway only. Detailed courses and full examinations will be developed in later phases.</p>
  </div></section>
  <section class="section section-soft"><div class="container">
    <div class="section-head"><div><span class="eyebrow">DESIGNED FOR REAL LEARNING</span><h2>A calmer, clearer<br/>way to study.</h2></div><p class="lead">Learning Japanese should feel exciting, not overwhelming. Every part of this academy is designed to help you understand one idea at a time.</p></div>
    <div class="feature-grid">
      <div class="feature-card"><div class="feature-icon" aria-hidden="true">文</div><h3>Learn in small steps</h3><p>A structured journey from writing systems to grammar, reading, and advanced expression.</p></div>
      <div class="feature-card"><div class="feature-icon" aria-hidden="true">問</div><h3>Practice, then understand</h3><p>Interactive exercises with useful explanations help transform guesses into understanding.</p></div>
      <div class="feature-card"><div class="feature-icon" aria-hidden="true">進</div><h3>Pick up where you left off</h3><p>Save lesson completions and quiz scores right in your browser—no login required.</p></div>
    </div>
  </div></section>
  <section class="section"><div class="container showcase">
    <div><span class="eyebrow">LANGUAGE WITH CONTEXT</span><h2>More than memorizing words.</h2><p class="lead">Japanese makes more sense when you see how the pieces fit together. Our future lessons will connect meaningful examples, explanations, readings, and practice.</p><a href="/learn/n5/hiragana-introduction/" class="btn btn-outline">Try a sample lesson <span aria-hidden="true">↗</span></a></div>
    <div class="study-sample"><span class="sample-label">A SNEAK PEEK INSIDE A LESSON</span><p class="sample-jp" lang="ja"><ruby>日本語<rt>にほんご</rt></ruby>を<ruby>勉強<rt>べんきょう</rt></ruby>します。</p><p class="sample-english">“I study Japanese.”</p><div class="sample-rule"></div><p class="sample-explainer">Small reading hints above the kanji are called <strong>furigana</strong>. They make authentic written Japanese easier to approach as you're learning.</p></div>
  </div></section>
  <section class="cta-area"><div class="container cta-inner"><div><span class="eyebrow" style="color:#fff">READY WHEN YOU ARE</span><h2>Your first step is free.<br/>So is every step after.</h2><p>Explore the N5 preview and get a feel for learning Japanese with FreeJapaneseAcademy.</p></div><a class="btn btn-light" href="/learn/n5/">Begin your journey <span aria-hidden="true">↗</span></a></div></section>
</Base>
